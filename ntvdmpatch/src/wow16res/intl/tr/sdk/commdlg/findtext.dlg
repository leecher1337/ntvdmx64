// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------

FINDDLGORD DIALOG LOADONCALL MOVEABLE DISCARDABLE
30, 73, 262, 62
CAPTION "Bul"
STYLE WS_BORDER | WS_CAPTION | DS_MODALFRAME | WS_POPUP | WS_SYSMENU
FONT 8, "Helv"
BEGIN
    CONTROL "A&ranan:", -1, "static", SS_LEFT | WS_CHILD,
        4, 8, 30, 8
    CONTROL "", edt1, "edit", ES_LEFT | ES_AUTOHSCROLL | WS_BORDER | WS_GROUP |
            WS_TABSTOP | WS_CHILD | WS_BORDER,
        47, 7, 128, 12

    CONTROL "Yal&nýzca Tam Sözcükleri Bul", chx1, "button", BS_AUTOCHECKBOX |
            WS_TABSTOP | WS_CHILD | WS_GROUP,
        4, 27, 106, 10
    CONTROL "&Büyük Küçük Harf Eþleþtir", chx2, "button", BS_AUTOCHECKBOX | 
            WS_TABSTOP | WS_CHILD,
        4, 44, 102, 12

    CONTROL "Yön", grp1, "button", BS_GROUPBOX | WS_CHILD,
        111, 27, 83, 28
    CONTROL "Y&ukarý", rad1, "button", BS_AUTORADIOBUTTON | 
            WS_TABSTOP | WS_CHILD | WS_GROUP,
         117, 39, 37, 12
    CONTROL "&Aþaðý", rad2, "button", BS_AUTORADIOBUTTON | WS_TABSTOP |
            WS_CHILD,
         157, 39, 33, 12

    CONTROL "&Sonrakini Bul", IDOK, "button", BS_DEFPUSHBUTTON | WS_CHILD |
            WS_TABSTOP | WS_GROUP,
       201, 5, 55, 14
    CONTROL "Ýptal", IDCANCEL, "button", BS_PUSHBUTTON | WS_CHILD | 
            WS_TABSTOP | WS_GROUP,
       201, 22, 55, 14
    CONTROL "&Yardým", pshHelp, "button", BS_PUSHBUTTON | WS_CHILD |
            WS_TABSTOP | WS_GROUP,
       201, 44, 55, 14
END


