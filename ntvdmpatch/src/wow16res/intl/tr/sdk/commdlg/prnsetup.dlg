PRINTDLGORD DIALOG LOADONCALL MOVEABLE DISCARDABLE 
36, 52,  225, 130
CAPTION "Yazdýr"
STYLE WS_CAPTION | WS_SYSMENU | WS_POPUP | DS_MODALFRAME
FONT 8, "Helv"
BEGIN
  LTEXT "Yazýcý:"  stc6, 4,    4,  40,   8
  LTEXT "Sistem Varsayýlaný"  stc1, 44,   4, 120,  18
  GROUPBOX "Yazdýrma Aralýðý", grp1, 4,   27,  132,  67
  RADIOBUTTON "&Tümü" rad1, 10,  39,  76,  12,  WS_TABSTOP | WS_GROUP
  RADIOBUTTON "S&eçim" rad2, 10,  52,  76,  12
  RADIOBUTTON "&Sayfa" rad3, 10,  65,  76,  12
  RTEXT "Ý&lk:"  stc2, 24,  80,  24,   9,  WS_GROUP
  EDITTEXT edt1, 52,  78,  26,  12,  WS_TABSTOP | ES_RIGHT
  RTEXT "S&on:"  stc3, 82,  80,  16,   9
  EDITTEXT edt2, 102,  78,  26,  12,  WS_TABSTOP | ES_RIGHT

  LTEXT "&Baský Kalitesi:"  stc4, 4,  100,  50,   9
  COMBOBOX      cmb1, 55,  98,  81,  36,
              WS_TABSTOP | CBS_DROPDOWNLIST | WS_GROUP | WS_BORDER | WS_VSCROLL

  LTEXT "&Kopya Sayýsý:", stc5, 147, 95,  33,   17
  EDITTEXT, edt3, 184,  98,  26,  12,  WS_TABSTOP | ES_RIGHT

  CHECKBOX "&Dosyaya Yazdýr"   chx1,
          4,  113, 120,  12,  BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP
  CHECKBOX "Kopyalarý &Harmanla"  chx2,
         147, 113,  76,  12,  BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP

  DEFPUSHBUTTON  "Tamam"  IDOK,     170,   4,  50,  14,  WS_GROUP
  PUSHBUTTON "Ýptal"  IDCANCEL, 170,  21,  50,  14,  WS_GROUP

  PUSHBUTTON "&Ayarlar..."  psh1,  170,  41,  50,  14,  WS_GROUP
  PUSHBUTTON "&Yardým"   pshHelp,  170,  75,  50,  14,  WS_GROUP
END


