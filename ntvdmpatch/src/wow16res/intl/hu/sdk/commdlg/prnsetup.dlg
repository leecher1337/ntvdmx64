//---------------------------------------------------------------------------
// prnsetup.dlg : reconstructed hu resources
//
// Recovered from the shipped localized commdlg.dll with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------

PRINTDLGORD DIALOG LOADONCALL MOVEABLE DISCARDABLE 
36, 52,  225, 130
CAPTION "Nyomtatás"
STYLE WS_CAPTION | WS_SYSMENU | WS_POPUP | DS_MODALFRAME
FONT 8, "Helv"
BEGIN
  LTEXT "Nyomtató:"  stc6, 4,    4,  40,   8
  LTEXT "Alapértelmezett"  stc1, 44,   4, 120,  18
  GROUPBOX "Nyomtatási tartomány", grp1, 4,   27,  132,  67
  RADIOBUTTON "&Minden" rad1, 10,  39,  76,  12,  WS_TABSTOP | WS_GROUP
  RADIOBUTTON "Kij&elölt terület" rad2, 10,  52,  76,  12
  RADIOBUTTON "&Oldalak" rad3, 10,  65,  76,  12
  RTEXT "E&lsõ:"  stc2, 24,  80,  16,   8,  WS_GROUP
  EDITTEXT edt1, 44,  78,  26,  12,  WS_TABSTOP | ES_RIGHT
  RTEXT "&Utolsó:"  stc3, 75,  80,  23,   8
  EDITTEXT edt2, 102,  78,  26,  12,  WS_TABSTOP | ES_RIGHT

  LTEXT "M&inõség:"  stc4, 4,  100,  50,   9
  COMBOBOX      cmb1, 55,  98,  81,  36,
              WS_TABSTOP | CBS_DROPDOWNLIST | WS_GROUP | WS_BORDER | WS_VSCROLL

  LTEXT "&Példányszám:", stc5, 143, 100,  44,   8
  EDITTEXT, edt3, 191,  98,  26,  12,  WS_TABSTOP | ES_RIGHT

  CHECKBOX "Nyomtatás &fájlba"   chx1,
          4,  113, 120,  12,  BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP
  CHECKBOX "S&zétválogatás"  chx2,
         143, 113,  77,  12,  BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP

  DEFPUSHBUTTON  "OK"  IDOK,     164,   4,  56,  14,  WS_GROUP
  PUSHBUTTON "Mégse"  IDCANCEL, 164,  21,  56,  14,  WS_GROUP

  PUSHBUTTON "&Telepítés..."  psh1,  164,  41,  56,  14,  WS_GROUP
  PUSHBUTTON "&Súgó"   pshHelp,  164,  75,  56,  14,  WS_GROUP
END


PRNSETUPDLGORD DIALOG LOADONCALL MOVEABLE DISCARDABLE 30, 23, 287, 122
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Nyomtatóbeállítás"
FONT 8, "Helv"
BEGIN
  GROUPBOX      "Nyomtató", grp3, 4, 6, 224, 66
  LTEXT         "(Nincs alapértelmezett nyomtató)", stc1, 18, 30, 208, 9
  RADIOBUTTON   "&Alapértelmezett nyomtató", rad3, 8, 16, 218, 12, WS_GROUP | WS_TABSTOP
  RADIOBUTTON   "&Egyéb nyomtató:", rad4, 8, 42, 218, 12
  COMBOBOX      cmb1, 18, 56, 208, 80, CBS_DROPDOWNLIST | WS_GROUP |
                WS_BORDER | WS_VSCROLL
  GROUPBOX      "Tájolás", grp1, 4, 74, 91, 46
  ICON          "", ico1, 12, 92, 24, 16
  RADIOBUTTON   "Á&lló", rad1, 40, 86, 53, 12, WS_GROUP | WS_TABSTOP
  RADIOBUTTON   "&Fekvõ", rad2, 40, 102, 53, 12
  GROUPBOX      "Papír", grp2, 100, 74, 128, 46, WS_GROUP
  LTEXT         "&Méret:", stc2, 104, 88, 26, 9
  COMBOBOX      cmb2, 134, 86, 92, 80, CBS_DROPDOWNLIST | WS_BORDER | 
                WS_VSCROLL | WS_TABSTOP
  LTEXT         "F&orrás:", stc3, 104, 104, 28, 9
  COMBOBOX      cmb3, 134, 102, 92, 80, CBS_DROPDOWNLIST | WS_BORDER | 
                WS_VSCROLL | WS_TABSTOP
  DEFPUSHBUTTON "OK", IDOK, 232, 4, 50, 14, WS_GROUP
  PUSHBUTTON    "Mégse", IDCANCEL, 232, 20, 50, 14, WS_GROUP
  PUSHBUTTON    "&Beállítások...", psh1, 232, 40, 50, 14, WS_GROUP
  PUSHBUTTON    "&Súgó", pshHelp, 232, 56, 50, 14, WS_GROUP
END

