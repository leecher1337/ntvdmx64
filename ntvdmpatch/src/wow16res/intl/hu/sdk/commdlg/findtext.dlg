            WS_TABSTOP | WS_CHILD | WS_GROUP,
        54, 7, 114, 12
    CONTROL "Cse&re erre:", -1, "static", SS_LEFT | WS_CHILD,
        4, 26, 48, 8
    CONTROL "", edt2, "edit", ES_LEFT | ES_AUTOHSCROLL | WS_BORDER |
            WS_TABSTOP | WS_CHILD | WS_GROUP,
        54, 24, 114, 12

    CONTROL "&Teljes szóval megegyezõ", chx1, "button", BS_AUTOCHECKBOX |
