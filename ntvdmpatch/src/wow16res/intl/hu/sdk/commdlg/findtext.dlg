        5, 46, 135, 12
    CONTROL "Kis- és &nagybetûk megkülönböztetése", chx2, "button", BS_AUTOCHECKBOX | WS_TABSTOP 
            | WS_CHILD,
        5, 62, 135, 12

    CONTROL "&Következõ keresése", IDOK, "button", BS_DEFPUSHBUTTON | WS_CHILD |
            WS_TABSTOP | WS_GROUP,
        174, 4, 78, 14
    CONTROL "&Csere", psh1, "button", BS_PUSHBUTTON | WS_CHILD | 
            WS_TABSTOP | WS_GROUP,
        174, 21, 78, 14
    CONTROL "A&z összes cseréje", psh2, "button", BS_PUSHBUTTON | WS_CHILD | 
