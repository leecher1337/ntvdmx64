//---------------------------------------------------------------------------
// drwatson.rc : reconstructed hu resources
//
// Recovered from the shipped localized drwatson.exe with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------
#define NOGDICAPMASKS
#define NOWINMESSAGES
#define NOSYSMETRICS
#define NOICON
#define NOKEYSTATE
#define NOSYSCOMMANDS
#define NOSHOWWINDOW
#define NOATOM
#define NOGDI
#define NOFONT
#define NOBRUSH
#define NOCLIPBOARD
#define NOCOLOR
#define NOCREATESTRUCT
#define NODRAWTEXT
#define NOMB
#define NOMEMMGR
#define NOMETAFILE
#define NOMINMAX
#define NOOPENFILE
#define NOPEN
#define NOREGION
#define NOSCROLL
#define NOSOUND
#define NOTEXTMETRIC
#define NOWH
#define NOWINOFFSETS
#define NOWNDCLASS
#define NOCOMM
#include <windows.h>

#include "drwatson.rcv"

#include "str.h"

drwatsonIcon ICON doctor.ico

#define DS_3DLOOK           0x0004

SHERDIAG DIALOG DISCARDABLE LOADONCALL PURE MOVEABLE 59, 42, 179, 124
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME | DS_3DLOOK
CAPTION "Dr. Watson nyomravezetése"
BEGIN
  CONTROL "Segíthet a probléma megoldásában, ha megpróbálja leírni, hogy mit csinált a hiba bekövetkezése elõtt." 101, "STATIC", WS_CHILD | WS_VISIBLE | 0x1L, 26, 5, 128, 26
  CONTROL "" 102, "EDIT", WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP | 0x44L, 13, 33, 151, 62
  CONTROL "OK" 1, "BUTTON", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 32, 101, 32, 14
  CONTROL "Mégse" 2, "BUTTON", WS_CHILD | WS_VISIBLE | WS_TABSTOP, 110, 101, 36, 14
END

STRINGTABLE PRELOAD DISCARDABLE
BEGIN

