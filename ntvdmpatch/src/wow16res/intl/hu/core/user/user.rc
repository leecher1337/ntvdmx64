// user.rc : reconstructed hu resources
//
// Recovered from the shipped localized user.exe with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------
/****************************************************************************/
/*                                                                          */
/*  USER.RC -                                                               */
/*                                                                          */
/*  USER's Resource File                                                    */
/*                                                                          */
/****************************************************************************/

#include "strtable.h"
#include "netdlg.h"


STRINGTABLE PRELOAD DISCARDABLE
BEGIN

    STR_NETDRIVER       "NETWORK.DRV"
    STR_BOOT            "boot"
    STR_LANGDRIVER      "LANGUAGE.DLL"
    STR_SYSTEMINI       "SYSTEM.INI"
    STR_TASKMAN         "TASKMAN.EXE"
    STR_DRIVERS         "DRIVERS"

/* Strings used for device driver initialization which we don't want hanging
 * around our ds.
 */
    STR_COMMMODULENAME,     "COMM"
    STR_COMMWRITESTRING,    "COMMWRITESTRING"
    STR_COMMREADSTRING,     "READCOMMSTRING"
    STR_COMMENABLENOTIFICATION "ENABLENOTIFICATION"

/*---------------------------------------------------------------------------*/
/* All strings above this line MUST NOT be localized.  All strings below
 * this line should be localized.
 */
    STR_NETCONNTTL      "Hiba történt a hálózati kapcsolatok helyreállítása közben"
    STR_NETCONNMSG      "Nem lehet kapcsolódni a következõhöz: %s. %s"
    STR_NETCRASHEDTITLE     "Hiba történt a hálózati kapcsolatok helyreállítása közben"
    STR_NETCRASHEDMSG       "A hálózati kapcsolatok helyreállítása közben a Windowst újraindították. Kívánja a hálózati kapcsolatok helyreállítását ebben a munkamenetben?"

    STR_NETERRORS       "Nem várt hálózati hiba: 0x%4.4X"
    STR_NETERRORS+1     "Ez a hálózati funkció nem támogatott"
    STR_NETERRORS+2     "Hálózati hiba"
    STR_NETERRORS+6     "Érvénytelen jelszó"
    STR_NETERRORS+7     "Hozzáférés megtagadva"
    STR_NETERRORS+11        "Nincs elég memória"
    STR_NETERRORS+0x30      "Az eszköz nincs csatlakoztatva"
    STR_NETERRORS+0x31      "Az eszközön nyitott fájlok vannak"
    STR_NETERRORS+0x32      "Érvénytelen hálózatnév"
    STR_NETERRORS+0x33      "Érvénytelen helyi eszköz"
    STR_NETERRORS+0x34      "Az eszköz már csatlakoztatva van"
    STR_NETERRORS+0x35      "A kapcsolat jelenleg nem aktív"
    STR_NETERRORS+0x36      "A folyamatos kapcsolat nem használható"

    STR_SYSERR,             "Rendszerhiba"
    STR_DIVBYZERO,          "Túlcsordulás vagy nullával való osztás"

END

#include "user.rcv"
