PRINTDLGORD DIALOG LOADONCALL MOVEABLE DISCARDABLE 
36, 52,  225, 130
CAPTION "Tisk"
STYLE WS_CAPTION | WS_SYSMENU | WS_POPUP | DS_MODALFRAME
FONT 8, "Helv"
BEGIN
  LTEXT "Tiskárna:"  stc6, 4,    4,  40,   8
  LTEXT "Výchozí systémové nastavení"  stc1, 44,   4, 120,  18
  GROUPBOX "Oblast tisku", grp1, 4,   27,  132,  67
  RADIOBUTTON "Vš&echny stránky" rad1, 10,  39,  76,  12,  WS_TABSTOP | WS_GROUP
  RADIOBUTTON "Vý&bìr" rad2, 10,  52,  76,  12
  RADIOBUTTON "&Stránky" rad3, 10,  65,  76,  12
  RTEXT "&od:"  stc2, 24,  80,  24,   9,  WS_GROUP
  EDITTEXT edt1, 52,  78,  26,  12,  WS_TABSTOP | ES_RIGHT
  RTEXT "&do:"  stc3, 82,  80,  16,   9
  EDITTEXT edt2, 102,  78,  26,  12,  WS_TABSTOP | ES_RIGHT

  LTEXT "Kva&lita tisku:"  stc4, 4,  100,  50,   9
  COMBOBOX      cmb1, 55,  98,  81,  36,
              WS_TABSTOP | CBS_DROPDOWNLIST | WS_GROUP | WS_BORDER | WS_VSCROLL

  LTEXT "Poèet &kopií:", stc5, 146, 100,  45,   9
  EDITTEXT, edt3, 193,  98,  26,  12,  WS_TABSTOP | ES_RIGHT

  CHECKBOX "Tisk do soubo&ru"   chx1,
          4,  113, 120,  12,  BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP
  CHECKBOX "Kompletov&at kopie"  chx2,
         146, 113,  74,  12,  BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP

  DEFPUSHBUTTON  "OK"  IDOK,     170,   4,  50,  14,  WS_GROUP
  PUSHBUTTON "Storno"  IDCANCEL, 170,  21,  50,  14,  WS_GROUP

  PUSHBUTTON "&Nastavit..."  psh1,  170,  41,  50,  14,  WS_GROUP
  PUSHBUTTON "Nápo&vìda"   pshHelp,  170,  75,  50,  14,  WS_GROUP
END


PRNSETUPDLGORD DIALOG LOADONCALL MOVEABLE DISCARDABLE 30, 23, 287, 122
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Nastavení tisku"
FONT 8, "Helv"
BEGIN
  GROUPBOX      "Tiskárna", grp3, 4, 6, 224, 66
  LTEXT         "(výchozí tiskárna není nastavena)", stc1, 16, 31, 208, 9
  RADIOBUTTON   "Výchozí &tiskárna", rad3, 8, 16, 218, 12, WS_GROUP | WS_TABSTOP
  RADIOBUTTON   "U&rèitá tiskárna:", rad4, 8, 42, 218, 12
  COMBOBOX      cmb1, 18, 55, 208, 80, CBS_DROPDOWNLIST | WS_GROUP |
                WS_BORDER | WS_VSCROLL
  GROUPBOX      "Orientace", grp1, 4, 74, 91, 46
  ICON          "", ico1, 12, 92, 24, 16
  RADIOBUTTON   "Na výš&ku", rad1, 40, 86, 53, 12, WS_GROUP | WS_TABSTOP
  RADIOBUTTON   "Na šíøk&u", rad2, 40, 102, 53, 12
  GROUPBOX      "Papír", grp2, 100, 74, 148, 46, WS_GROUP
  LTEXT         "&Velikost:", stc2, 104, 88, 28, 9
  COMBOBOX      cmb2, 137, 86, 107, 65, CBS_DROPDOWNLIST | WS_BORDER | 
                WS_VSCROLL | WS_TABSTOP
  LTEXT         "&Zdroj:", stc3, 104, 104, 23, 8
  COMBOBOX      cmb3, 137, 102, 107, 59, CBS_DROPDOWNLIST | WS_BORDER | 
                WS_VSCROLL | WS_TABSTOP
  DEFPUSHBUTTON "OK", IDOK, 232, 4, 50, 14, WS_GROUP
  PUSHBUTTON    "Storno", IDCANCEL, 232, 20, 50, 14, WS_GROUP
  PUSHBUTTON    "&Možnosti...", psh1, 232, 40, 50, 14, WS_GROUP
  PUSHBUTTON    "&Nápovìda", pshHelp, 232, 56, 50, 14, WS_GROUP
END

