//---------------------------------------------------------------------------
// color.dlg : reconstructed cs resources
//
// Recovered from the shipped localized commdlg.dll with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------
#include "colordlg.h"

ChooseColor DIALOG LOADONCALL MOVEABLE DISCARDABLE 2, 0, 318, 184
CAPTION "Barvy"
STYLE WS_BORDER | DS_MODALFRAME | WS_CAPTION | WS_POPUP | WS_SYSMENU
FONT 8 "Helv"
BEGIN
  LTEXT "&Základní barvy:", -1, 4, 4, 140, 9

  CONTROL "", COLOR_BOX1, "static", SS_SIMPLE | WS_CHILD | WS_TABSTOP | WS_GROUP, 4, 14, 140, 86

  LTEXT "Vl&astní barvy:", -1, 4, 106, 140, 9

  CONTROL "",  COLOR_CUSTOM1, "static", SS_SIMPLE | WS_CHILD | WS_TABSTOP | WS_GROUP, 4, 116, 140, 28

  PUSHBUTTON "&Definovat vlastní barvy..." COLOR_MIX, 4, 150, 140, 14, WS_TABSTOP | WS_GROUP

  DEFPUSHBUTTON "OK",      IDOK,  4, 166, 44, 14, WS_GROUP | WS_TABSTOP
  PUSHBUTTON "Storno", IDCANCEL, 52, 166, 44, 14, WS_GROUP | WS_TABSTOP
  PUSHBUTTON "Nápo&vìda",  pshHelp, 100, 166, 44, 14, WS_GROUP | WS_TABSTOP

  CONTROL "",  COLOR_RAINBOW, "static", SS_BLACKFRAME | WS_CHILD, 152, 4, 118, 116

  CONTROL "",  COLOR_LUMSCROLL, "static", SS_SIMPLE | WS_CHILD, 280, 4, 8, 116

  CONTROL "", COLOR_CURRENT, "static", SS_BLACKFRAME | WS_CHILD, 152, 124, 43, 26

  PUSHBUTTON "&l", COLOR_SOLID, 300, 200, 4, 14, WS_GROUP

  RTEXT "Barva |", -1, 152, 151, 23, 9

  LTEXT "Pl&ná", -1, 175, 151, 20, 9


  RTEXT "&Odstín:", COLOR_HUEACCEL, 197, 126, 36, 9

  EDITTEXT, COLOR_HUE, 235, 124, 18, 12, WS_GROUP | WS_TABSTOP

  RTEXT "&Sytost:", COLOR_SATACCEL, 197, 140, 36, 9

  EDITTEXT, COLOR_SAT, 235, 138, 18, 12, WS_GROUP | WS_TABSTOP

  RTEXT "Svì&telnost:", COLOR_LUMACCEL, 197, 154, 36, 9

  EDITTEXT, COLOR_LUM, 235, 152, 18, 12, WS_GROUP | WS_TABSTOP

  RTEXT "&R:", COLOR_REDACCEL, 262, 126, 24, 9

  EDITTEXT, COLOR_RED, 288, 124, 23, 12, WS_GROUP | WS_TABSTOP

  RTEXT "&G:", COLOR_GREENACCEL, 262, 140, 24, 9

  EDITTEXT, COLOR_GREEN, 288, 138, 23, 12, WS_GROUP | WS_TABSTOP

  RTEXT "&B:", COLOR_BLUEACCEL, 262, 154, 24, 9

  EDITTEXT, COLOR_BLUE, 288, 152, 23, 12, WS_GROUP | WS_TABSTOP

  PUSHBUTTON "&Pøidat do vlastních barev", COLOR_ADD, 164, 166, 147, 14, WS_GROUP | WS_TABSTOP

END
