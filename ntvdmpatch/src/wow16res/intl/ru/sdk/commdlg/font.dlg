//---------------------------------------------------------------------------
// font.dlg : reconstructed ru resources
//
// Recovered from the shipped localized commdlg.dll with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------

FORMATDLGORD31 DIALOG 13, 54, 310, 178
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Шрифт"
FONT 8, "Helv"
BEGIN
    LTEXT           "&Шрифт:", stc1, 7, 6, 40, 9
    COMBOBOX        cmb1, 7, 16, 103, 76, CBS_SIMPLE | CBS_AUTOHSCROLL | CBS_SORT | WS_VSCROLL | WS_TABSTOP | CBS_HASSTRINGS | CBS_OWNERDRAWFIXED | CBS_DISABLENOSCROLL

    LTEXT           "&Начертание:", stc2, 115, 6, 49, 9
    COMBOBOX        cmb2, 115, 16, 97, 76, CBS_SIMPLE | WS_VSCROLL | CBS_DISABLENOSCROLL | WS_TABSTOP

    LTEXT           "&Размер:", stc3, 217, 6, 30, 9
    COMBOBOX        cmb3, 217, 16, 27, 76, CBS_SIMPLE | WS_VSCROLL | WS_TABSTOP | CBS_HASSTRINGS | CBS_OWNERDRAWFIXED | CBS_SORT | CBS_DISABLENOSCROLL

    DEFPUSHBUTTON   "ОК", IDOK, 250, 16, 50, 14, WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "Отмена", IDCANCEL, 250, 35, 50, 14, WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "При&менить", psh3, 250, 54, 50, 14, WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "&Справка", pshHelp, 250, 73, 50, 14, WS_GROUP | WS_TABSTOP

    GROUPBOX        "Эффекты", grp1, 7, 97, 103, 72, WS_GROUP
    CONTROL         "&Зачеркнутый", chx1, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 110, 67, 10
    CONTROL         "Под&черкнутый", chx2, "Button", BS_AUTOCHECKBOX, 15, 123, 74, 10

    LTEXT           "Ц&вет:", stc4, 15, 140, 31, 9
    COMBOBOX        cmb4, 15, 150, 88, 100, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_AUTOHSCROLL | CBS_HASSTRINGS | WS_BORDER | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Образец", grp2, 115, 97, 184, 49, WS_GROUP
    CTEXT           "", stc6, 115, 150, 175, 21,  SS_NOPREFIX | NOT WS_GROUP
    CTEXT           "AaBbБбФф", stc5, 122, 108, 163, 33, SS_NOPREFIX | NOT WS_VISIBLE
END

