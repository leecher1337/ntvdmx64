FILEOPENORD DIALOG LOADONCALL MOVEABLE DISCARDABLE 
36, 24,  290, 135
CAPTION "Открытие файла"
STYLE WS_CAPTION | WS_SYSMENU | WS_POPUP | DS_MODALFRAME
FONT 8, "Helv"
BEGIN
    LTEXT "&Имя файла:", stc3,   6,   6,  76,  9
    CONTROL "", edt1, "edit", ES_LEFT | ES_AUTOHSCROLL | WS_BORDER |
            WS_TABSTOP | WS_CHILD | ES_OEMCONVERT,
            6,    16,  105,  12
    CONTROL "", lst1, "listbox",
            LBS_SORT | LBS_HASSTRINGS | LBS_NOTIFY | LBS_DISABLENOSCROLL
            | WS_VSCROLL | WS_CHILD | WS_BORDER | WS_TABSTOP
            | LBS_OWNERDRAWFIXED,
            6,    32,  105,  68

    LTEXT "Пап&ки:", -1, 120,   6,  92,   9
    LTEXT "",            stc1, 120,  18,  92,   9, SS_NOPREFIX
    CONTROL "", lst2, "listbox", 
            LBS_SORT | LBS_HASSTRINGS | LBS_NOTIFY | LBS_DISABLENOSCROLL
            | WS_VSCROLL | WS_CHILD | WS_BORDER | WS_TABSTOP
            | LBS_OWNERDRAWFIXED,
            120,  32,  92,  68

    LTEXT "&Тип файлов:", stc2, 6,  104,  90,   9
    CONTROL "", cmb1, "combobox", CBS_DROPDOWNLIST | CBS_AUTOHSCROLL |
            WS_BORDER | WS_VSCROLL | WS_TABSTOP | WS_CHILD,
            6,  114,  105,  36

    LTEXT "&Диски:", stc4,      120, 104,  92,  9
    CONTROL "", cmb2, "combobox", 
            CBS_SORT | CBS_HASSTRINGS | CBS_OWNERDRAWFIXED | CBS_DROPDOWNLIST 
            | WS_CHILD | CBS_AUTOHSCROLL | WS_BORDER | WS_VSCROLL 
            | WS_TABSTOP,
            120, 114,  92, 68 

    DEFPUSHBUTTON "ОК", IDOK,       220,  6, 60, 14, WS_GROUP
    PUSHBUTTON "Отмена", IDCANCEL,  220, 24, 60, 14, WS_GROUP

    PUSHBUTTON "&Справка", pshHelp,      220, 46, 60, 14, WS_GROUP
    CHECKBOX "Только &чтение", chx1,    220, 69, 64, 11,
                        BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP

END

MULTIFILEOPENORD DIALOG LOADONCALL MOVEABLE DISCARDABLE 
36, 24,  290, 135
CAPTION "Открытие файла"
STYLE WS_CAPTION | WS_SYSMENU | WS_POPUP | DS_MODALFRAME
FONT 8, "Helv"
BEGIN
    LTEXT "&Имя файла:", stc3,   6,   6,  76,  10
    CONTROL "", edt1, "edit", ES_LEFT | ES_AUTOHSCROLL | WS_BORDER |
            WS_TABSTOP | WS_CHILD | ES_OEMCONVERT,
            6,    16,  105,  12
    CONTROL "", lst1, "listbox", LBS_SORT | LBS_NOTIFY | LBS_DISABLENOSCROLL |
             WS_VSCROLL | WS_BORDER | WS_TABSTOP | LBS_EXTENDEDSEL
            | LBS_HASSTRINGS | LBS_OWNERDRAWFIXED,
            6,    32,  105,  68

    LTEXT "Пап&ки:", -1, 120,   6,  92,   9
    LTEXT "",            stc1, 120,  16,  92,   9, SS_NOPREFIX
    CONTROL "", lst2, "listbox", 
            LBS_SORT | LBS_HASSTRINGS | LBS_NOTIFY | LBS_DISABLENOSCROLL
            | WS_VSCROLL | WS_CHILD | WS_BORDER | WS_TABSTOP
            | LBS_OWNERDRAWFIXED,
            120,  32,  92,  68

    LTEXT "&Тип файлов:", stc2, 6,  102,  90,   9
    CONTROL "", cmb1, "combobox", CBS_DROPDOWNLIST | CBS_AUTOHSCROLL |
            WS_BORDER | WS_VSCROLL | WS_TABSTOP | WS_CHILD,
            6,  112,  105,  36

    LTEXT "&Диски:", stc4,      120, 102,  92,  9
    CONTROL "", cmb2, "combobox", 
            CBS_SORT | CBS_HASSTRINGS | CBS_OWNERDRAWFIXED | CBS_DROPDOWNLIST 
            | WS_CHILD | CBS_AUTOHSCROLL | WS_BORDER | WS_VSCROLL 
            | WS_TABSTOP,
            120, 112,  92, 68 

    DEFPUSHBUTTON "ОК", IDOK,       220,  6, 60, 14, WS_GROUP
    PUSHBUTTON "Отмена", IDCANCEL,  220, 24, 60, 14, WS_GROUP

    PUSHBUTTON "&Справка", pshHelp,      220, 46, 60, 14, WS_GROUP
    CHECKBOX "Только &чтение", chx1,    220, 68, 65, 12,
                        BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP

END
