//---------------------------------------------------------------------------
// prnsetup.dlg : reconstructed pt resources
//
// Recovered from the shipped localized commdlg.dll with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------

PRINTDLGORD DIALOG LOADONCALL MOVEABLE DISCARDABLE 
36, 52,  225, 140
CAPTION "Imprimir"
STYLE WS_CAPTION | WS_SYSMENU | WS_POPUP | DS_MODALFRAME
FONT 8, "Helv"
BEGIN
  LTEXT "Impressora:"  stc6, 4,    4,  40,   8
  LTEXT "Predefinição do sistema"  stc1, 44,   4, 120,  18
  GROUPBOX "Intervalo de impressão", grp1, 4,   27,  132,  67
  RADIOBUTTON "T&odas" rad1, 10,  39,  76,  12,  WS_TABSTOP | WS_GROUP
  RADIOBUTTON "&Selecção" rad2, 10,  52,  76,  12
  RADIOBUTTON "&Páginas" rad3, 10,  65,  76,  12
  RTEXT "&De:"  stc2, 24,  80,  24,   9,  WS_GROUP
  EDITTEXT edt1, 52,  78,  26,  12,  WS_TABSTOP | ES_RIGHT
  RTEXT "A&té:"  stc3, 82,  80,  16,   9
  EDITTEXT edt2, 102,  78,  26,  12,  WS_TABSTOP | ES_RIGHT

  LTEXT "&Qualidade de impressão:"  stc4, 4,  100,  50,   17
  COMBOBOX      cmb1, 55,  100,  81,  36,
              WS_TABSTOP | CBS_DROPDOWNLIST | WS_GROUP | WS_BORDER | WS_VSCROLL

  LTEXT "&Cópias:", stc5, 153, 103,  29,   9
  EDITTEXT, edt3, 184,  100,  26,  12,  WS_TABSTOP | ES_RIGHT

  CHECKBOX "&Imprimir para ficheiro"   chx1,
          4,  123, 120,  12,  BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP
  CHECKBOX "Agr&upar cópias"  chx2,
         153, 123,  67,  12,  BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP

  DEFPUSHBUTTON  "OK"  IDOK,     170,   4,  50,  14,  WS_GROUP
  PUSHBUTTON "Cancelar"  IDCANCEL, 170,  21,  50,  14,  WS_GROUP

  PUSHBUTTON "Co&nfigurar..."  psh1,  170,  41,  50,  14,  WS_GROUP
  PUSHBUTTON "&Ajuda"   pshHelp,  170,  75,  50,  14,  WS_GROUP
END


PRNSETUPDLGORD DIALOG LOADONCALL MOVEABLE DISCARDABLE 30, 23, 288, 127
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Configurar impressão"
FONT 8, "Helv"
BEGIN
  GROUPBOX      "Impressora", grp3, 4, 6, 224, 70
  LTEXT         "(Sem impressora predefinida)", stc1, 18, 32, 91, 8
  RADIOBUTTON   "Impressora pre&definida", rad3, 8, 19, 87, 10, WS_GROUP | WS_TABSTOP
  RADIOBUTTON   "&Impressora específica:", rad4, 8, 45, 87, 10
  COMBOBOX      cmb1, 18, 59, 207, 80, CBS_DROPDOWNLIST | WS_GROUP |
                WS_BORDER | WS_VSCROLL
  GROUPBOX      "Orientação", grp1, 4, 78, 87, 46
  ICON          "", ico1, 12, 92, 24, 16
  RADIOBUTTON   "&Vertical", rad1, 39, 90, 39, 10, WS_GROUP | WS_TABSTOP
  RADIOBUTTON   "&Horizontal", rad2, 39, 106, 47, 10
  GROUPBOX      "Papel", grp2, 96, 78, 132, 46, WS_GROUP
  LTEXT         "&Tamanho:", stc2, 101, 92, 33, 8
  COMBOBOX      cmb2, 137, 90, 88, 65, CBS_DROPDOWNLIST | WS_BORDER | 
                WS_VSCROLL | WS_TABSTOP
  LTEXT         "Orige&m:", stc3, 101, 108, 25, 8
  COMBOBOX      cmb3, 137, 106, 88, 59, CBS_DROPDOWNLIST | WS_BORDER | 
                WS_VSCROLL | WS_TABSTOP
  DEFPUSHBUTTON "OK", IDOK, 233, 4, 50, 14, WS_GROUP
  PUSHBUTTON    "Cancelar", IDCANCEL, 233, 21, 50, 14, WS_GROUP
  PUSHBUTTON    "&Opções...", psh1, 233, 41, 50, 14, WS_GROUP
  PUSHBUTTON    "&Ajuda", pshHelp, 233, 58, 50, 14, WS_GROUP
END

