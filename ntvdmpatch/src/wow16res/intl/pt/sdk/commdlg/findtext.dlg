            WS_TABSTOP | WS_CHILD | WS_GROUP,
        55, 7, 114, 12
    CONTROL "S&ubstituir por:", -1, "static", SS_LEFT | WS_CHILD,
        3, 26, 47, 8
    CONTROL "", edt2, "edit", ES_LEFT | ES_AUTOHSCROLL | WS_BORDER |
            WS_TABSTOP | WS_CHILD | WS_GROUP,
        55, 24, 114, 12

    CONTROL "Apenas palavras &inteiras", chx1, "button", BS_AUTOCHECKBOX |
            WS_TABSTOP | WS_CHILD | WS_GROUP,
        5, 46, 127, 12
    CONTROL "&Maiúsculas/minúsculas", chx2, "button", BS_AUTOCHECKBOX | WS_TABSTOP 
            | WS_CHILD,
        5, 62, 127, 12

    CONTROL "&Localizar seguinte", IDOK, "button", BS_DEFPUSHBUTTON | WS_CHILD |
            WS_TABSTOP | WS_GROUP,
        174, 4, 68, 14
    CONTROL "&Substituir", psh1, "button", BS_PUSHBUTTON | WS_CHILD | 
            WS_TABSTOP | WS_GROUP,
        174, 21, 68, 14
    CONTROL "Substituir &tudo", psh2, "button", BS_PUSHBUTTON | WS_CHILD | 
            WS_TABSTOP | WS_GROUP,
        174, 38, 68, 14
    CONTROL "Cancelar", IDCANCEL, "button", BS_PUSHBUTTON | WS_CHILD |
