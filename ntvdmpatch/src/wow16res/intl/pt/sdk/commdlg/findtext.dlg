//---------------------------------------------------------------------------
// findtext.dlg : reconstructed pt resources
//
// Recovered from the shipped localized commdlg.dll with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------

FINDDLGORD DIALOG LOADONCALL MOVEABLE DISCARDABLE
30, 73, 280, 70
CAPTION "Localizar"
STYLE WS_BORDER | WS_CAPTION | DS_MODALFRAME | WS_POPUP | WS_SYSMENU
FONT 8, "Helv"
BEGIN
    CONTROL "Locali&zar:", -1, "static", SS_LEFT | WS_CHILD,
        4, 8, 40, 8
    CONTROL "", edt1, "edit", ES_LEFT | ES_AUTOHSCROLL | WS_BORDER | WS_GROUP |
            WS_TABSTOP | WS_CHILD | WS_BORDER,
        47, 7, 152, 12

    CONTROL "Apenas palavras &inteiras", chx1, "button", BS_AUTOCHECKBOX |
            WS_TABSTOP | WS_CHILD | WS_GROUP,
        3, 34, 93, 10
    CONTROL "&Maiúsculas/minúsculas", chx2, "button", BS_AUTOCHECKBOX | 
            WS_TABSTOP | WS_CHILD,
        3, 50, 89, 10

    CONTROL "Direcção", grp1, "button", BS_GROUPBOX | WS_CHILD,
        132, 20, 67, 47
    CONTROL "Para &cima", rad1, "button", BS_AUTORADIOBUTTON | 
            WS_TABSTOP | WS_CHILD | WS_GROUP,
         138, 32, 47, 10
    CONTROL "Para &baixo", rad2, "button", BS_AUTORADIOBUTTON | WS_TABSTOP |
            WS_CHILD,
         138, 48, 49, 10

    CONTROL "&Localizar seguinte", IDOK, "button", BS_DEFPUSHBUTTON | WS_CHILD |
            WS_TABSTOP | WS_GROUP,
       205, 5, 68, 14
    CONTROL "Cancelar", IDCANCEL, "button", BS_PUSHBUTTON | WS_CHILD | 
            WS_TABSTOP | WS_GROUP,
       205, 23, 68, 14
    CONTROL "&Ajuda", pshHelp, "button", BS_PUSHBUTTON | WS_CHILD |
            WS_TABSTOP | WS_GROUP,
       205, 45, 68, 14
END


