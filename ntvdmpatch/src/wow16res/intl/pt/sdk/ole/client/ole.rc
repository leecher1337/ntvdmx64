//---------------------------------------------------------------------------
// ole.rc : reconstructed pt resources
//
// Recovered from the shipped localized olecli.dll with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------
#include <windows.h>

//----Version Stamping-------------------------------------------------------
#include "olecli.rcv"

CONNECTDLG DIALOG FIXED IMPURE  76, 55, 171, 78
STYLE DS_MODALFRAME | WS_POPUPWINDOW | WS_DLGFRAME
CAPTION "Ligar unidade de rede"
BEGIN
	CONTROL "&Unidade:",        -1, "STATIC", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP, 24, 8, 40, 9
	CONTROL "",               500, "COMBOBOX", CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP | WS_TABSTOP, 69, 4, 20, 40
	CONTROL "Caminho de &rede:", -1, "STATIC", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP, 0, 21, 64, 8
	CONTROL "",               502, "EDIT", ES_LEFT | ES_AUTOHSCROLL | ES_OEMCONVERT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_GROUP | WS_TABSTOP, 69, 20, 96, 12
	CONTROL "&Palavra-passe:",     -1, "STATIC", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP, 6, 35, 58, 10
	CONTROL "",               501, "EDIT", ES_LEFT | ES_PASSWORD | ES_AUTOHSCROLL | ES_OEMCONVERT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_GROUP | WS_TABSTOP, 69, 35, 60, 12
	CONTROL "&Ligar",       IDOK, "BUTTON", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 29, 57, 45, 14
	CONTROL "&Cancelar",        IDCANCEL, "BUTTON", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 97, 57, 45, 14
END

STRINGTABLE
BEGIN
    600, "Erro de rede"
    601, "Não é possível ligar à unidade de rede."
END
