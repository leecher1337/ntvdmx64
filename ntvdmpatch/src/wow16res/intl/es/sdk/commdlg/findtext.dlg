//---------------------------------------------------------------------------
// findtext.dlg : reconstructed es resources
//
// Recovered from the shipped localized commdlg.dll with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------

FINDDLGORD DIALOG LOADONCALL MOVEABLE DISCARDABLE
30, 73, 280, 63
CAPTION "Buscar"
STYLE WS_BORDER | WS_CAPTION | DS_MODALFRAME | WS_POPUP | WS_SYSMENU
FONT 8, "Helv"
BEGIN
    CONTROL "&Buscar:", -1, "static", SS_LEFT | WS_CHILD,
        4, 8, 42, 8
    CONTROL "", edt1, "edit", ES_LEFT | ES_AUTOHSCROLL | WS_BORDER | WS_GROUP |
            WS_TABSTOP | WS_CHILD | WS_BORDER,
        53, 7, 146, 12

    CONTROL "Sólo palabras &completas", chx1, "button", BS_AUTOCHECKBOX |
            WS_TABSTOP | WS_CHILD | WS_GROUP,
        1, 26, 100, 12
    CONTROL "Coincidir &mayúsculas y minúsculas", chx2, "button", BS_AUTOCHECKBOX | 
            WS_TABSTOP | WS_CHILD,
        1, 42, 119, 12

    CONTROL "Dirección", grp1, "button", BS_GROUPBOX | WS_CHILD,
        125, 26, 86, 28
    CONTROL "A&rriba", rad1, "button", BS_AUTORADIOBUTTON | 
            WS_TABSTOP | WS_CHILD | WS_GROUP,
         128, 38, 36, 12
    CONTROL "Abaj&o", rad2, "button", BS_AUTORADIOBUTTON | WS_TABSTOP |
            WS_CHILD,
         167, 38, 37, 12

    CONTROL "Buscar &siguiente", IDOK, "button", BS_DEFPUSHBUTTON | WS_CHILD |
            WS_TABSTOP | WS_GROUP,
       215, 4, 62, 14
    CONTROL "Cancelar", IDCANCEL, "button", BS_PUSHBUTTON | WS_CHILD | 
            WS_TABSTOP | WS_GROUP,
       215, 23, 62, 14
    CONTROL "Ay&uda", pshHelp, "button", BS_PUSHBUTTON | WS_CHILD |
            WS_TABSTOP | WS_GROUP,
       215, 43, 62, 14
END


REPLACEDLGORD DIALOG LOADONCALL MOVEABLE DISCARDABLE
36, 44, 247, 94
CAPTION "Reemplazar"
STYLE WS_BORDER | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME | WS_POPUP
FONT 8, "Helv"
BEGIN
    CONTROL "&Buscar:", -1, "static", SS_LEFT | WS_CHILD,
        4, 9, 52, 8
    CONTROL "", edt1, "edit", ES_LEFT | ES_AUTOHSCROLL | WS_BORDER | 
            WS_TABSTOP | WS_CHILD | WS_GROUP,
        58, 7, 114, 12
    CONTROL "Reempla&zar por:", -1, "static", SS_LEFT | WS_CHILD,
        4, 26, 52, 8
    CONTROL "", edt2, "edit", ES_LEFT | ES_AUTOHSCROLL | WS_BORDER |
            WS_TABSTOP | WS_CHILD | WS_GROUP,
        58, 24, 114, 12

    CONTROL "Sólo palabras &completas", chx1, "button", BS_AUTOCHECKBOX |
            WS_TABSTOP | WS_CHILD | WS_GROUP,
        5, 46, 166, 12
    CONTROL "Coincidir &mayúsculas y minúsculas", chx2, "button", BS_AUTOCHECKBOX | WS_TABSTOP 
            | WS_CHILD,
        5, 62, 165, 12

    CONTROL "Buscar &siguiente", IDOK, "button", BS_DEFPUSHBUTTON | WS_CHILD |
            WS_TABSTOP | WS_GROUP,
        178, 4, 63, 14
    CONTROL "&Reemplazar", psh1, "button", BS_PUSHBUTTON | WS_CHILD | 
            WS_TABSTOP | WS_GROUP,
        178, 21, 63, 14
    CONTROL "Reemplazar &todo", psh2, "button", BS_PUSHBUTTON | WS_CHILD | 
            WS_TABSTOP | WS_GROUP,
        178, 38, 63, 14
    CONTROL "Cancelar", IDCANCEL, "button", BS_PUSHBUTTON | WS_CHILD |
            WS_TABSTOP | WS_GROUP,
        178, 55, 63, 14
    CONTROL "Ay&uda", pshHelp, "button", BS_PUSHBUTTON | WS_CHILD |
            WS_TABSTOP | WS_GROUP,
        178, 75, 63, 14

END
