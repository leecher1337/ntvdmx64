//---------------------------------------------------------------------------
// drwatson.rc : reconstructed es resources
//
// Recovered from the shipped localized drwatson.exe with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------
#define NOGDICAPMASKS
#define NOWINMESSAGES
#define NOSYSMETRICS
#define NOICON
#define NOKEYSTATE
#define NOSYSCOMMANDS
#define NOSHOWWINDOW
#define NOATOM
#define NOGDI
#define NOFONT
#define NOBRUSH
#define NOCLIPBOARD
#define NOCOLOR
#define NOCREATESTRUCT
#define NODRAWTEXT
#define NOMB
#define NOMEMMGR
#define NOMETAFILE
#define NOMINMAX
#define NOOPENFILE
#define NOPEN
#define NOREGION
#define NOSCROLL
#define NOSOUND
#define NOTEXTMETRIC
#define NOWH
#define NOWINOFFSETS
#define NOWNDCLASS
#define NOCOMM
#include <windows.h>

#include "drwatson.rcv"

#include "str.h"

drwatsonIcon ICON doctor.ico

#define DS_3DLOOK           0x0004

SHERDIAG DIALOG DISCARDABLE LOADONCALL PURE MOVEABLE 59, 42, 179, 124
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME | DS_3DLOOK
CAPTION "Pistas de Dr. Watson"
BEGIN
  CONTROL "Para poder ayudarle a resolver el problema encontrado, describa lo que estaba haciendo cuando ocurrió el error." 101, "STATIC", WS_CHILD | WS_VISIBLE | 0x1L, 13, 5, 151, 26
  CONTROL "" 102, "EDIT", WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP | 0x44L, 13, 33, 151, 62
  CONTROL "Aceptar" 1, "BUTTON", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 32, 101, 40, 14
  CONTROL "Cancelar" 2, "BUTTON", WS_CHILD | WS_VISIBLE | WS_TABSTOP, 106, 101, 40, 14
END

STRINGTABLE PRELOAD DISCARDABLE
BEGIN

/* Note all strings below must be <= CCH_MAX_STRING_RESOURCE chars! */

/* drwatson.c */

IDSTRNoFault                           "No se han detectado errores\n\nCopyright 1991-1995, Microsoft Corp."
IDSTRFaulty                            "%d nuevos informes de error de ""Dr. Watson"" en el archivo '%s'\n\nCopyright 1991-1995, Microsoft Corp."
IDSTRGPText                            "Error en su aplicación.\nSi elige Omitir, deberá grabar su trabajo en un archivo nuevo.\nSi elige Cerrar, su aplicación terminará."
