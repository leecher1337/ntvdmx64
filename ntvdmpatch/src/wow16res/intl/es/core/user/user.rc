//---------------------------------------------------------------------------
// user.rc : reconstructed es resources
//
// Recovered from the shipped localized user.exe with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------
/****************************************************************************/
/*                                                                          */
/*  USER.RC -                                                               */
/*                                                                          */
/*  USER's Resource File                                                    */
/*                                                                          */
/****************************************************************************/

#include "strtable.h"
#include "netdlg.h"


STRINGTABLE PRELOAD DISCARDABLE
BEGIN

    STR_NETDRIVER       "NETWORK.DRV"
    STR_BOOT            "boot"
    STR_LANGDRIVER      "LANGUAGE.DLL"
    STR_SYSTEMINI       "SYSTEM.INI"
    STR_TASKMAN         "TASKMAN.EXE"
    STR_DRIVERS         "DRIVERS"

/* Strings used for device driver initialization which we don't want hanging
 * around our ds.
 */
    STR_COMMMODULENAME,     "COMM"
    STR_COMMWRITESTRING,    "COMMWRITESTRING"
    STR_COMMREADSTRING,     "READCOMMSTRING"
    STR_COMMENABLENOTIFICATION "ENABLENOTIFICATION"

/*---------------------------------------------------------------------------*/
/* All strings above this line MUST NOT be localized.  All strings below
 * this line should be localized.
 */
    STR_NETCONNTTL      "Error al restaurar las conexiones de red"
    STR_NETCONNMSG      "Error al conectar con %s: %s"
    STR_NETCRASHEDTITLE     "Error al restaurar las conexiones de red"
    STR_NETCRASHEDMSG       "Windows ha vuelto a iniciarse mientras restauraba las conexiones de la red. ¿Desea volver a intentar establecer las conexiones o cancelar las conexiones de red de esta sesión?"

    STR_NETERRORS       "Error de red inesperado: 0x%4.4X"
    STR_NETERRORS+1     "La función de la red no es compatible"
    STR_NETERRORS+2     "Error de red"
    STR_NETERRORS+6     "Contraseña incorrecta"
    STR_NETERRORS+7     "Acceso denegado"
    STR_NETERRORS+11        "Memoria insuficiente"
    STR_NETERRORS+0x30      "Dispositivo no conectado"
    STR_NETERRORS+0x31      "El dispositivo tiene archivos abiertos"
    STR_NETERRORS+0x32      "El nombre de la red no es válido"
    STR_NETERRORS+0x33      "El dispositivo local no es válido"
    STR_NETERRORS+0x34      "El dispositivo ya está conectado"
    STR_NETERRORS+0x35      "Se ha perdido la conexión"
    STR_NETERRORS+0x36      "No se dispone de una conexión permanente"

    STR_SYSERR,             "Error del sistema"
    STR_DIVBYZERO,          "Error de división entre cero o de desbordamiento"

END

#include "user.rcv"
