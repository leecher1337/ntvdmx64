//---------------------------------------------------------------------------
// user.rc : reconstructed it resources
//
// Recovered from the shipped localized user.exe with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------
/****************************************************************************/
/*                                                                          */
/*  USER.RC -                                                               */
/*                                                                          */
/*  USER's Resource File                                                    */
/*                                                                          */
/****************************************************************************/

#include "strtable.h"
#include "netdlg.h"


STRINGTABLE PRELOAD DISCARDABLE
BEGIN

    STR_NETDRIVER       "NETWORK.DRV"
    STR_BOOT            "boot"
    STR_LANGDRIVER      "LANGUAGE.DLL"
    STR_SYSTEMINI       "SYSTEM.INI"
    STR_TASKMAN         "TASKMAN.EXE"
    STR_DRIVERS         "DRIVERS"

/* Strings used for device driver initialization which we don't want hanging
 * around our ds.
 */
    STR_COMMMODULENAME,     "COMM"
    STR_COMMWRITESTRING,    "COMMWRITESTRING"
    STR_COMMREADSTRING,     "READCOMMSTRING"
    STR_COMMENABLENOTIFICATION "ENABLENOTIFICATION"

/*---------------------------------------------------------------------------*/
/* All strings above this line MUST NOT be localized.  All strings below
 * this line should be localized.
 */
    STR_NETCONNTTL      "Errore durante il ripristino delle connessioni in rete."
    STR_NETCONNMSG      "Impossibile connettersi a %s: %s"
    STR_NETCRASHEDTITLE     "Errore durante il ripristino delle connessioni in rete."
    STR_NETCRASHEDMSG       "Windows è stato riavviato durante il ripristino delle connessioni in rete. Riprovare a ristabilire le connessioni in rete o annullarle per questa sessione?"

    STR_NETERRORS       "Errore di rete inatteso: 0x%4.4X"
    STR_NETERRORS+1     "Funzionalità di rete non supportata."
    STR_NETERRORS+2     "Errore di rete"
    STR_NETERRORS+6     "Password non corretta."
    STR_NETERRORS+7     "Accesso negato."
    STR_NETERRORS+11        "Memoria insufficiente"
    STR_NETERRORS+0x30      "Periferica non connessa."
    STR_NETERRORS+0x31      "La periferica ha dei file aperti."
    STR_NETERRORS+0x32      "Nome di rete non valido."
    STR_NETERRORS+0x33      "Periferica locale non valida."
    STR_NETERRORS+0x34      "Periferica già connessa"
    STR_NETERRORS+0x35      "La connessione è interrotta."
    STR_NETERRORS+0x36      "Connessione permanente non disponibile."

    STR_SYSERR,             "Errore di sistema"
    STR_DIVBYZERO,          "Errore di divisione per zero o overflow"

END

#include "user.rcv"
