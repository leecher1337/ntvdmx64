//---------------------------------------------------------------------------
// color.dlg : reconstructed it resources
//
// Recovered from the shipped localized commdlg.dll with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------
#include "colordlg.h"

ChooseColor DIALOG LOADONCALL MOVEABLE DISCARDABLE 2, 0, 324, 183
CAPTION "Colore"
STYLE WS_BORDER | DS_MODALFRAME | WS_CAPTION | WS_POPUP | WS_SYSMENU
FONT 8 "Helv"
BEGIN
  LTEXT "&Colori di base:", -1, 4, 4, 140, 9

  CONTROL "", COLOR_BOX1, "static", SS_SIMPLE | WS_CHILD | WS_TABSTOP | WS_GROUP, 4, 14, 140, 86

  LTEXT "Colori &personalizzati:", -1, 4, 106, 140, 9

  CONTROL "",  COLOR_CUSTOM1, "static", SS_SIMPLE | WS_CHILD | WS_TABSTOP | WS_GROUP, 4, 116, 140, 28

  PUSHBUTTON "&Definisci colori personalizzati..." COLOR_MIX, 4, 150, 140, 14, WS_TABSTOP | WS_GROUP

  DEFPUSHBUTTON "OK",      IDOK,  4, 166, 44, 14, WS_GROUP | WS_TABSTOP
  PUSHBUTTON "Annulla", IDCANCEL, 52, 166, 44, 14, WS_GROUP | WS_TABSTOP
  PUSHBUTTON "&?",  pshHelp, 100, 166, 44, 14, WS_GROUP | WS_TABSTOP

  CONTROL "",  COLOR_RAINBOW, "static", SS_BLACKFRAME | WS_CHILD, 152, 4, 118, 116

  CONTROL "",  COLOR_LUMSCROLL, "static", SS_SIMPLE | WS_CHILD, 280, 4, 8, 116

  CONTROL "", COLOR_CURRENT, "static", SS_BLACKFRAME | WS_CHILD, 152, 124, 40, 26

  PUSHBUTTON "&o", COLOR_SOLID, 300, 200, 8, 14, WS_GROUP

  RTEXT "Colore|", -1, 150, 151, 22, 8

  LTEXT "Ti&nta unita", -1, 173, 151, 34, 8


  RTEXT "&Tonalità:", COLOR_HUEACCEL, 209, 126, 40, 9

  EDITTEXT, COLOR_HUE, 252, 124, 18, 12, WS_GROUP | WS_TABSTOP

  RTEXT "&Saturazione:", COLOR_SATACCEL, 209, 140, 40, 8

  EDITTEXT, COLOR_SAT, 252, 138, 18, 12, WS_GROUP | WS_TABSTOP

  RTEXT "&Luminosità:", COLOR_LUMACCEL, 213, 154, 36, 8

  EDITTEXT, COLOR_LUM, 252, 152, 18, 12, WS_GROUP | WS_TABSTOP

  RTEXT "&Rosso:", COLOR_REDACCEL, 276, 126, 24, 9

  EDITTEXT, COLOR_RED, 303, 124, 18, 12, WS_GROUP | WS_TABSTOP

  RTEXT "&Verde:", COLOR_GREENACCEL, 276, 140, 24, 9

  EDITTEXT, COLOR_GREEN, 303, 138, 18, 12, WS_GROUP | WS_TABSTOP

  RTEXT "&Blu:", COLOR_BLUEACCEL, 276, 154, 24, 9

  EDITTEXT, COLOR_BLUE, 303, 152, 18, 12, WS_GROUP | WS_TABSTOP

  PUSHBUTTON "&Aggiungi ai colori personalizzati", COLOR_ADD, 175, 166, 146, 14, WS_GROUP | WS_TABSTOP

END
