//---------------------------------------------------------------------------
// prnsetup.dlg : reconstructed it resources
//
// Recovered from the shipped localized commdlg.dll with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------

PRINTDLGORD DIALOG LOADONCALL MOVEABLE DISCARDABLE 
36, 52,  225, 130
CAPTION "Stampa"
STYLE WS_CAPTION | WS_SYSMENU | WS_POPUP | DS_MODALFRAME
FONT 8, "Helv"
BEGIN
  LTEXT "Stampante:"  stc6, 4,    4,  36,   8
  LTEXT "Predefinita"  stc1, 44,   4, 120,  18
  GROUPBOX "Intervallo di stampa", grp1, 4,   27,  139,  67
  RADIOBUTTON "&Tutto il documento" rad1, 10,  39,  76,  12,  WS_TABSTOP | WS_GROUP
  RADIOBUTTON "S&elezione" rad2, 10,  52,  76,  12
  RADIOBUTTON "&Pagine" rad3, 10,  65,  76,  12
  RTEXT "&Da:"  stc2, 24,  80,  24,   9,  WS_GROUP
  EDITTEXT edt1, 52,  78,  26,  12,  WS_TABSTOP | ES_RIGHT
  RTEXT "&A:"  stc3, 82,  80,  16,   9
  EDITTEXT edt2, 102,  78,  26,  12,  WS_TABSTOP | ES_RIGHT

  LTEXT "&Qualità di stampa:"  stc4, 4,  100,  56,   8
  COMBOBOX      cmb1, 64,  98,  81,  36,
              WS_TABSTOP | CBS_DROPDOWNLIST | WS_GROUP | WS_BORDER | WS_VSCROLL

  LTEXT "Numero &copie:", stc5, 151, 95,  28,   17
  EDITTEXT, edt3, 184,  98,  26,  12,  WS_TABSTOP | ES_RIGHT

  CHECKBOX "Stampa s&u file"   chx1,
          4,  113, 120,  12,  BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP
  CHECKBOX "&Fascicola copie"  chx2,
         153, 113,  67,  12,  BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP

  DEFPUSHBUTTON  "OK"  IDOK,     170,   4,  50,  14,  WS_GROUP
  PUSHBUTTON "Annulla"  IDCANCEL, 170,  21,  50,  14,  WS_GROUP

  PUSHBUTTON "&Imposta..."  psh1,  170,  41,  50,  14,  WS_GROUP
  PUSHBUTTON "&?"   pshHelp,  170,  75,  50,  14,  WS_GROUP
END


PRNSETUPDLGORD DIALOG LOADONCALL MOVEABLE DISCARDABLE 30, 23, 287, 122
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Imposta stampante"
FONT 8, "Helv"
BEGIN
  GROUPBOX      "Stampante", grp3, 4, 6, 224, 66
  LTEXT         "(Nessuna stampante predefinita)", stc1, 18, 30, 208, 9
  RADIOBUTTON   "&Stampante predefinita", rad3, 8, 16, 218, 12, WS_GROUP | WS_TABSTOP
  RADIOBUTTON   "S&tampante specifica:", rad4, 8, 42, 218, 12
  COMBOBOX      cmb1, 18, 56, 208, 80, CBS_DROPDOWNLIST | WS_GROUP |
                WS_BORDER | WS_VSCROLL
  GROUPBOX      "Orientamento", grp1, 4, 74, 91, 46
  ICON          "", ico1, 12, 92, 24, 16
  RADIOBUTTON   "&Verticale", rad1, 40, 86, 53, 12, WS_GROUP | WS_TABSTOP
  RADIOBUTTON   "Ori&zzontale", rad2, 40, 102, 53, 12
  GROUPBOX      "Foglio", grp2, 100, 74, 128, 46, WS_GROUP
  LTEXT         "&Dimens.:", stc2, 104, 88, 28, 9
  COMBOBOX      cmb2, 134, 86, 92, 80, CBS_DROPDOWNLIST | WS_BORDER | 
                WS_VSCROLL | WS_TABSTOP
  LTEXT         "&Aliment.:", stc3, 104, 104, 28, 9
  COMBOBOX      cmb3, 134, 102, 92, 80, CBS_DROPDOWNLIST | WS_BORDER | 
                WS_VSCROLL | WS_TABSTOP
  DEFPUSHBUTTON "OK", IDOK, 232, 4, 50, 14, WS_GROUP
  PUSHBUTTON    "Annulla", IDCANCEL, 232, 20, 50, 14, WS_GROUP
  PUSHBUTTON    "&Opzioni...", psh1, 232, 40, 50, 14, WS_GROUP
  PUSHBUTTON    "&?", pshHelp, 232, 56, 50, 14, WS_GROUP
END

