STRINGTABLE LOADONCALL MOVEABLE DISCARDABLE
BEGIN
	1,		"Driver de timer"
	2,		"Não foi possível encontrar o arquivo VTDAPI.386. Os timers de multimídia não estão disponíveis.\nVerifique se o arquivo se encontra na pasta SYSTEM do Windows e se a linha\ndevice=VTDAPI.386 foi incluída na seção [386Enh] do arquivo SYSTEM.INI."
END
