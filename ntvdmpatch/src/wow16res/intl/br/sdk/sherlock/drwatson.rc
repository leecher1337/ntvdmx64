IDSTRNA                                "não disponível."
IDSTRHadAFaultAt2                      "%s tinha um erro '%s (%x)' em '%s\n"
IDSTRParamIs                           "parâmetro é %lx$%s\n"

/* drwatson.c Moriarty */

IDSTRStop                              "Parar"

/* drwatson.c SherlockWndProc */

IDSTRLogFileGettingLarge               "O arquivo de log '%s' do Dr. Watson está ficando muito grande."

/* drwatson.c WinMain */

IDSTRStart                             "\nIniciar"

/* error.c LogErrorStr */

IDSTRWarningError                      "\r\n\r\nAviso # %04x"
IDSTRFatalError                        "\r\n\r\nErro fatal # %04x"

/* error.c LogParamErrorStr */

IDSTRParamErrorParam                   "Parâmetro inválido passado para %s: %ld"
IDSTRParamErrorBadInt                  "Parâmetro inválido passado para %s: %d"
IDSTRParamErrorBadFlags                "Sinalizadores inválidos passados para %s: %#04x"
