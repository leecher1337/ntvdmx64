//---------------------------------------------------------------------------
// drwatson.rc : reconstructed br resources
//
// Recovered from the shipped localized drwatson.exe with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------
#define NOGDICAPMASKS
#define NOWINMESSAGES
#define NOSYSMETRICS
#define NOICON
#define NOKEYSTATE
#define NOSYSCOMMANDS
#define NOSHOWWINDOW
#define NOATOM
#define NOGDI
#define NOFONT
#define NOBRUSH
#define NOCLIPBOARD
#define NOCOLOR
#define NOCREATESTRUCT
#define NODRAWTEXT
#define NOMB
#define NOMEMMGR
#define NOMETAFILE
#define NOMINMAX
#define NOOPENFILE
#define NOPEN
#define NOREGION
#define NOSCROLL
#define NOSOUND
#define NOTEXTMETRIC
#define NOWH
#define NOWINOFFSETS
#define NOWNDCLASS
#define NOCOMM
#include <windows.h>

#include "drwatson.rcv"

#include "str.h"

drwatsonIcon ICON doctor.ico

#define DS_3DLOOK           0x0004

SHERDIAG DIALOG DISCARDABLE LOADONCALL PURE MOVEABLE 59, 42, 179, 124
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME | DS_3DLOOK
CAPTION "Dicas do Dr. Watson"
BEGIN
  CONTROL "Para que o Dr. Watson possa ajudá-lo a resolver o problema encontrado, descreva o que você estava fazendo antes de a falha ter ocorrido." 101, "STATIC", WS_CHILD | WS_VISIBLE | 0x1L, 12, 5, 155, 25
  CONTROL "" 102, "EDIT", WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP | 0x44L, 13, 33, 151, 62
  CONTROL "OK" 1, "BUTTON", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 36, 101, 40, 14
  CONTROL "Cancelar" 2, "BUTTON", WS_CHILD | WS_VISIBLE | WS_TABSTOP, 106, 101, 40, 14
END

STRINGTABLE PRELOAD DISCARDABLE
BEGIN

/* Note all strings below must be <= CCH_MAX_STRING_RESOURCE chars! */

/* drwatson.c */

IDSTRNoFault                           "Nenhuma falha detectada\n\nCopyright 1991-1995, Microsoft Corp."
IDSTRFaulty                            "%d novos relatórios de falhas do Dr. Watson podem ser encontrados no arquivo'%s'\n\nCopyright 1991-1995, Microsoft Corp."
IDSTRGPText                            "Erro no aplicativo.\nSe você escolher 'Ignorar', deve salvar o trabalho em um novo arquivo.\nSe escolher 'Fechar', o aplicativo será finalizado."
IDSTRErrMsg                            "O Dr. Watson já está sendo executado no sistema."
IDSTRVers                              "Não é possível instalar o Dr. Watson. A versão do TOOLHELP.DLL pode ser incorreta"
