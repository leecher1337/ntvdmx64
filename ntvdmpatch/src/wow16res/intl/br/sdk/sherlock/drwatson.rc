/* drwatson.c DumpInfo */

IDSTRSystemInfoInfo                    "Informação do sistema (info)\n"
IDSTRWindowsVersion                    "Versão %d.%02d do Windows\n"
IDSTRDebugBuild                        "Compilação para depuração\n"
IDSTRRetailBuild                       "Compilação para venda\n"
