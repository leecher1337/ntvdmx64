IDSTRDec                               "dez"

IDSTRSun                               "dom"
IDSTRMon                               "seg"
IDSTRTue                               "ter"
IDSTRWed                               "qua"
IDSTRThu                               "qui"
IDSTRFri                               "sex"
IDSTRSat                               "sáb"

END
