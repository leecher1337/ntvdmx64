//---------------------------------------------------------------------------
// prnsetup.dlg : reconstructed br resources
//
// Recovered from the shipped localized commdlg.dll with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------

PRINTDLGORD DIALOG LOADONCALL MOVEABLE DISCARDABLE 
36, 52,  233, 135
CAPTION "Imprimir"
STYLE WS_CAPTION | WS_SYSMENU | WS_POPUP | DS_MODALFRAME
FONT 8, "Helv"
BEGIN
  LTEXT "Impressora:"  stc6, 4,    4,  37,   8
  LTEXT "Padrão do sistema"  stc1, 44,   4, 120,  18
  GROUPBOX "Intervalo de impressão", grp1, 4,   27,  162,  67
  RADIOBUTTON "&Tudo" rad1, 10,  39,  33,  10,  WS_TABSTOP | WS_GROUP
  RADIOBUTTON "&Seleção" rad2, 10,  52,  42,  10
  RADIOBUTTON "&Páginas" rad3, 10,  65,  41,  10
  RTEXT "&De:"  stc2, 24,  80,  12,   8,  WS_GROUP
  EDITTEXT edt1, 40,  78,  26,  12,  WS_TABSTOP | ES_RIGHT
  RTEXT "&a:"  stc3, 78,  80,  8,   8
  EDITTEXT edt2, 91,  78,  26,  12,  WS_TABSTOP | ES_RIGHT

  LTEXT "&Qualidade de impressão:"  stc4, 4,  100,  78,   8
  COMBOBOX      cmb1, 85,  98,  81,  36,
              WS_TABSTOP | CBS_DROPDOWNLIST | WS_GROUP | WS_BORDER | WS_VSCROLL

  LTEXT "&Cópias:", stc5, 172, 99,  24,   8
  EDITTEXT, edt3, 200,  97,  26,  12,  WS_TABSTOP | ES_RIGHT

  CHECKBOX "I&mprimir em arquivo"   chx1,
          4,  113, 120,  12,  BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP
  CHECKBOX "Ag&rupar cópias"  chx2,
         166, 118,  63,  10,  BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP

  DEFPUSHBUTTON  "OK"  IDOK,     176,   4,  50,  16,  WS_GROUP
  PUSHBUTTON "Cancelar"  IDCANCEL, 176,  24,  50,  16,  WS_GROUP

  PUSHBUTTON "Co&nfigurar..."  psh1,  176,  44,  50,  16,  WS_GROUP
  PUSHBUTTON "Aj&uda"   pshHelp,  176,  71,  50,  16,  WS_GROUP
END


PRNSETUPDLGORD DIALOG LOADONCALL MOVEABLE DISCARDABLE 30, 23, 290, 122
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Configurar impressão"
FONT 8, "Helv"
BEGIN
  GROUPBOX      "Impressora", grp3, 4, 3, 228, 66
  LTEXT         "(Nenhuma impressora padrão)", stc1, 19, 27, 95, 8
  RADIOBUTTON   "&Impressora padrão", rad3, 8, 14, 74, 10, WS_GROUP | WS_TABSTOP
  RADIOBUTTON   "Impressora &específica:", rad4, 8, 38, 87, 10
  COMBOBOX      cmb1, 18, 52, 212, 80, CBS_DROPDOWNLIST | WS_GROUP |
                WS_BORDER | WS_VSCROLL
  GROUPBOX      "Orientação", grp1, 4, 71, 91, 46
  ICON          "", ico1, 12, 88, 24, 16
  RADIOBUTTON   "&Retrato", rad1, 40, 84, 39, 10, WS_GROUP | WS_TABSTOP
  RADIOBUTTON   "&Paisagem", rad2, 40, 99, 47, 10
  GROUPBOX      "Papel", grp2, 100, 71, 132, 46, WS_GROUP
  LTEXT         "&Tamanho:", stc2, 104, 85, 33, 8
  COMBOBOX      cmb2, 138, 83, 92, 80, CBS_DROPDOWNLIST | WS_BORDER | 
                WS_VSCROLL | WS_TABSTOP
  LTEXT         "&Fonte:", stc3, 104, 101, 25, 8
  COMBOBOX      cmb3, 138, 99, 92, 80, CBS_DROPDOWNLIST | WS_BORDER | 
                WS_VSCROLL | WS_TABSTOP
  DEFPUSHBUTTON "OK", IDOK, 236, 7, 50, 16, WS_GROUP
  PUSHBUTTON    "Cancelar", IDCANCEL, 236, 27, 50, 16, WS_GROUP
  PUSHBUTTON    "&Opções...", psh1, 236, 47, 50, 16, WS_GROUP
  PUSHBUTTON    "Aj&uda", pshHelp, 236, 67, 50, 16, WS_GROUP
END

