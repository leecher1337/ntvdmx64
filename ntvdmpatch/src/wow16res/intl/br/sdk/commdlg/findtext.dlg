// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------

FINDDLGORD DIALOG LOADONCALL MOVEABLE DISCARDABLE
30, 73, 296, 61
CAPTION "Localizar"
STYLE WS_BORDER | WS_CAPTION | DS_MODALFRAME | WS_POPUP | WS_SYSMENU
FONT 8, "Helv"
BEGIN
    CONTROL "L&ocalizar:", -1, "static", SS_LEFT | WS_CHILD,
        4, 9, 31, 8
    CONTROL "", edt1, "edit", ES_LEFT | ES_AUTOHSCROLL | WS_BORDER | WS_GROUP |
            WS_TABSTOP | WS_CHILD | WS_BORDER,
        39, 8, 183, 12

    CONTROL "Co&incidir palavra inteira", chx1, "button", BS_AUTOCHECKBOX |
            WS_TABSTOP | WS_CHILD | WS_GROUP,
        4, 29, 90, 10
    CONTROL "&Diferenciar maiúsculas de minúsculas", chx2, "button", BS_AUTOCHECKBOX | 
            WS_TABSTOP | WS_CHILD,
        4, 44, 133, 10

    CONTROL "Direção", grp1, "button", BS_GROUPBOX | WS_CHILD,
        138, 29, 84, 28
    CONTROL "A&cima", rad1, "button", BS_AUTORADIOBUTTON | 
            WS_TABSTOP | WS_CHILD | WS_GROUP,
         143, 41, 35, 10
    CONTROL "A&baixo", rad2, "button", BS_AUTORADIOBUTTON | WS_TABSTOP |
            WS_CHILD,
         184, 41, 34, 10

    CONTROL "&Localizar próxima", IDOK, "button", BS_DEFPUSHBUTTON | WS_CHILD |
            WS_TABSTOP | WS_GROUP,
       227, 7, 63, 14
    CONTROL "Cancelar", IDCANCEL, "button", BS_PUSHBUTTON | WS_CHILD | 
            WS_TABSTOP | WS_GROUP,
       227, 25, 63, 14
    CONTROL "Aj&uda", pshHelp, "button", BS_PUSHBUTTON | WS_CHILD |
            WS_TABSTOP | WS_GROUP,
       227, 43, 63, 14
END


