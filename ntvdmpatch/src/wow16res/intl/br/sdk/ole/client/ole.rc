//---------------------------------------------------------------------------
// ole.rc : reconstructed br resources
//
// Recovered from the shipped localized olecli.dll with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------
#include <windows.h>

//----Version Stamping-------------------------------------------------------
#include "olecli.rcv"

CONNECTDLG DIALOG FIXED IMPURE  76, 55, 165, 76
STYLE DS_MODALFRAME | WS_POPUPWINDOW | WS_DLGFRAME
CAPTION "Conectar unidade de rede"
BEGIN
	CONTROL "Uni&dade:",        -1, "STATIC", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP, 9, 7, 50, 9
	CONTROL "",               500, "COMBOBOX", CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP | WS_TABSTOP, 63, 3, 20, 40
	CONTROL "Ca&minho de rede:", -1, "STATIC", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP, 3, 21, 56, 8
	CONTROL "",               502, "EDIT", ES_LEFT | ES_AUTOHSCROLL | ES_OEMCONVERT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_GROUP | WS_TABSTOP, 63, 20, 96, 12
	CONTROL "&Senha:",     -1, "STATIC", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP, 13, 37, 46, 10
	CONTROL "",               501, "EDIT", ES_LEFT | ES_PASSWORD | ES_AUTOHSCROLL | ES_OEMCONVERT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_GROUP | WS_TABSTOP, 63, 35, 60, 12
	CONTROL "&Conectar",       IDOK, "BUTTON", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 22, 54, 42, 14
	CONTROL "C&ancelar",        IDCANCEL, "BUTTON", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 100, 55, 43, 14
END

STRINGTABLE
BEGIN
    600, "Erro de rede"
    601, "Não é possível conectar a unidade da rede."
END
