//---------------------------------------------------------------------------
// user.rc : reconstructed ger resources
//
// Recovered from the shipped localized user.exe with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------
/****************************************************************************/
/*                                                                          */
/*  USER.RC -                                                               */
/*                                                                          */
/*  USER's Resource File                                                    */
/*                                                                          */
/****************************************************************************/

#include "strtable.h"
#include "netdlg.h"


STRINGTABLE PRELOAD DISCARDABLE
BEGIN

    STR_NETDRIVER       "NETWORK.DRV"
    STR_BOOT            "boot"
    STR_LANGDRIVER      "LANGUAGE.DLL"
    STR_SYSTEMINI       "SYSTEM.INI"
    STR_TASKMAN         "TASKMAN.EXE"
    STR_DRIVERS         "DRIVERS"

/* Strings used for device driver initialization which we don't want hanging
 * around our ds.
 */
    STR_COMMMODULENAME,     "COMM"
    STR_COMMWRITESTRING,    "COMMWRITESTRING"
    STR_COMMREADSTRING,     "READCOMMSTRING"
    STR_COMMENABLENOTIFICATION "ENABLENOTIFICATION"

/*---------------------------------------------------------------------------*/
/* All strings above this line MUST NOT be localized.  All strings below
 * this line should be localized.
 */
    STR_NETCONNTTL      "Fehler beim Wiederherstellen der Netzwerkverbindungen"
    STR_NETCONNMSG      "Verbindung zu %s kann nicht hergestellt werden: %s"
    STR_NETCRASHEDTITLE     "Fehler beim Wiederherstellen der Netzwerkverbindungen"
    STR_NETCRASHEDMSG       "Windows wurde während der Wiederherstellung der Netzwerkverbindungen neu gestartet. Soll der Versuch, die Netzwerkverbindungen wiederherzustellen, wiederholt werden?"

    STR_NETERRORS       "Unerwarteter Netzwerkfehler: 0x%4.4X"
    STR_NETERRORS+1     "Netzwerkfunktion wird nicht unterstützt"
    STR_NETERRORS+2     "Netzwerkfehler"
    STR_NETERRORS+6     "Ungültiges Kennwort"
    STR_NETERRORS+7     "Zugriff verweigert"
    STR_NETERRORS+11        "Nicht genügend Arbeitsspeicher."
    STR_NETERRORS+0x30      "Gerät nicht verbunden"
    STR_NETERRORS+0x31      "Geöffnete Dateien auf dem Laufwerk"
    STR_NETERRORS+0x32      "Ungültiger Netzwerkname"
    STR_NETERRORS+0x33      "Ungültiges lokales Gerät"
    STR_NETERRORS+0x34      "Gerät bereits verbunden"
    STR_NETERRORS+0x35      "Verbindung wurde unterbrochen"
    STR_NETERRORS+0x36      "Permanente Verbindung nicht verfügbar"

    STR_SYSERR,             "Systemfehler"
    STR_DIVBYZERO,          "Division durch Null oder Überlauf"

END

#include "user.rcv"
