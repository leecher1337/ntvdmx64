//---------------------------------------------------------------------------
// ddeml.dlg : reconstructed ger resources
//
// Recovered from the shipped localized ddeml.dll with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------
DLGINCLUDE RCDATA DISCARDABLE
BEGIN
    "DDEMLP.H\0"
END

TermDialog DIALOG 91, 34, 181, 143
STYLE DS_SYSMODAL | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION |
    WS_SYSMENU
CAPTION "Windows DDE"
FONT 8, "Helv"
BEGIN
    LTEXT           "Eine Anwendung, die DDE verwendet, hat nicht auf den Befehl ""Schließen"" des Systems reagiert.",
                    101, 7, 7, 168, 23
    LTEXT           "Klicken Sie auf ""Wiederholen"", um den Vorgang zu wiederholen und zu Windows zurückzukehren.",
                    102, 27, 32, 148, 24
    LTEXT           "Klicken Sie auf ""Fortsetzen"", um das Schließen wiederholt zu versuchen und zu Windows zurückzukehren.",
                    103, 27, 58, 148, 24
    LTEXT           "Klicken Sie auf ""Schließen"", um die nicht reagierende Anwendung zu schließen. Ungesicherte Daten in dieser Anwendung können möglicherweise verloren gehen.",
                    104, 27, 84, 148, 34
    DEFPUSHBUTTON   "Wiederholen", IDRETRY, 15, 122, 47, 14
    PUSHBUTTON      "Weiter", IDIGNORE, 70, 122, 47, 14
    PUSHBUTTON      "Schließen", IDABORT, 125, 122, 47, 14
    LTEXT           "*", 108, 15, 33, 8, 24
    LTEXT           "*", 109, 15, 59, 8, 24
    LTEXT           "*", 110, 15, 85, 8, 24
END
