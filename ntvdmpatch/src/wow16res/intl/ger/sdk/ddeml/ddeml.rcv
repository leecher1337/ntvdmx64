/********************************************************************/
/*        DDEML.RCV                                                 */
/*        Version control data generated from layouts.dat           */
/********************************************************************/
#include <version.h>

/*
 * DDEML needs a special version stamp because intermediate versions
 * were shipped with apps like Excel 5.0 (v3.12)
 *
 * WOW Daytona and Chicago versions should be identical and set to 3.5
 * (SanfordS)
 */
#undef VERSION
#define VERSION 		    "3.5"
#undef VER_PRODUCTVERSION_STR
#define VER_PRODUCTVERSION_STR      "3.50\0"
#undef VER_PRODUCTVERSION
#define VER_PRODUCTVERSION          3,50,0,103


#define VER_FILETYPE                    VFT_DLL
#define VER_FILESUBTYPE                 VFT_UNKNOWN
#define VER_INTERNALNAME_STR            "DDEML"
#define VER_ORIGINALFILENAME_STR        "DDEML.DLL"



/*-------------------------------------------------*/
/* localized strings and language of this resource */
/*-------------------------------------------------*/
#undef VER_FILEDESCRIPTION_STR
#define VER_FILEDESCRIPTION_STR     "DDE-Verwaltung"
#undef VER_PRODUCTNAME_STR
#define VER_PRODUCTNAME_STR         "Betriebssystem Microsoft(R) Windows(TM)"
#undef VER_LEGALCOPYRIGHT_STR
#define VER_LEGALCOPYRIGHT_STR      "Copyright © Microsoft Corp. 1981-1996\0"
#define VER_LANGID                  0x0407
#define VER_CHARSETID               0x04E4
#define VER_STRINGFILEINFO_BLOCK    "040704E4"

#include <common.ver>
