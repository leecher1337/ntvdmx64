FILEOPENORD DIALOG LOADONCALL MOVEABLE DISCARDABLE 
19, 24,  327, 134
CAPTION "Öffnen"
STYLE WS_CAPTION | WS_SYSMENU | WS_POPUP | DS_MODALFRAME
FONT 8, "Helv"
BEGIN
    LTEXT "&Dateiname:", stc3,   6,   6,  115,  9
    CONTROL "", edt1, "edit", ES_LEFT | ES_AUTOHSCROLL | WS_BORDER |
            WS_TABSTOP | WS_CHILD | ES_OEMCONVERT,
            6,    16,  115,  12
    CONTROL "", lst1, "listbox",
            LBS_SORT | LBS_HASSTRINGS | LBS_NOTIFY | LBS_DISABLENOSCROLL
            | WS_VSCROLL | WS_CHILD | WS_BORDER | WS_TABSTOP
            | LBS_OWNERDRAWFIXED,
            6,    32,  115,  68

    LTEXT "&Verzeichnisse:", -1, 135,   6,  115,   9
    LTEXT "",            stc1, 135,  18,  115,   10, SS_NOPREFIX
    CONTROL "", lst2, "listbox", 
            LBS_SORT | LBS_HASSTRINGS | LBS_NOTIFY | LBS_DISABLENOSCROLL
            | WS_VSCROLL | WS_CHILD | WS_BORDER | WS_TABSTOP
            | LBS_OWNERDRAWFIXED,
            135,  32,  115,  68

    LTEXT "Datei&typ:", stc2, 6,  104,  115,   9
    CONTROL "", cmb1, "combobox", CBS_DROPDOWNLIST | CBS_AUTOHSCROLL |
            WS_BORDER | WS_VSCROLL | WS_TABSTOP | WS_CHILD,
            6,  114,  115,  44

    LTEXT "&Laufwerke:", stc4,      135, 104,  115,  9
    CONTROL "", cmb2, "combobox", 
            CBS_SORT | CBS_HASSTRINGS | CBS_OWNERDRAWFIXED | CBS_DROPDOWNLIST 
            | WS_CHILD | CBS_AUTOHSCROLL | WS_BORDER | WS_VSCROLL 
            | WS_TABSTOP,
            135, 114,  115, 68 

    DEFPUSHBUTTON "OK", IDOK,       277,  6, 44, 14, WS_GROUP
    PUSHBUTTON "Abbrechen", IDCANCEL,  277, 26, 44, 14, WS_GROUP

    PUSHBUTTON "&Hilfe", pshHelp,      277, 46, 44, 14, WS_GROUP
    CHECKBOX "&Schreibgeschützt", chx1,    255, 66, 68, 12,
                        BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP

END

MULTIFILEOPENORD DIALOG LOADONCALL MOVEABLE DISCARDABLE 
19, 24,  327, 134
CAPTION "Öffnen"
STYLE WS_CAPTION | WS_SYSMENU | WS_POPUP | DS_MODALFRAME
FONT 8, "Helv"
BEGIN
    LTEXT "&Dateiname:", stc3,   6,   6,  115,  9
    CONTROL "", edt1, "edit", ES_LEFT | ES_AUTOHSCROLL | WS_BORDER |
            WS_TABSTOP | WS_CHILD | ES_OEMCONVERT,
            6,    16,  115,  12
    CONTROL "", lst1, "listbox", LBS_SORT | LBS_NOTIFY | LBS_DISABLENOSCROLL |
             WS_VSCROLL | WS_BORDER | WS_TABSTOP | LBS_EXTENDEDSEL
            | LBS_HASSTRINGS | LBS_OWNERDRAWFIXED,
            6,    32,  115,  68

    LTEXT "&Verzeichnisse:", -1, 135,   6,  115,   9
    LTEXT "",            stc1, 135,  16,  115,   10, SS_NOPREFIX
    CONTROL "", lst2, "listbox", 
            LBS_SORT | LBS_HASSTRINGS | LBS_NOTIFY | LBS_DISABLENOSCROLL
            | WS_VSCROLL | WS_CHILD | WS_BORDER | WS_TABSTOP
            | LBS_OWNERDRAWFIXED,
            135,  32,  115,  68

    LTEXT "Datei&typ:", stc2, 6,  102,  115,   9
    CONTROL "", cmb1, "combobox", CBS_DROPDOWNLIST | CBS_AUTOHSCROLL |
            WS_BORDER | WS_VSCROLL | WS_TABSTOP | WS_CHILD,
            6,  112,  115,  36

    LTEXT "&Laufwerke:", stc4,      135, 102,  115,  9
    CONTROL "", cmb2, "combobox", 
            CBS_SORT | CBS_HASSTRINGS | CBS_OWNERDRAWFIXED | CBS_DROPDOWNLIST 
            | WS_CHILD | CBS_AUTOHSCROLL | WS_BORDER | WS_VSCROLL 
            | WS_TABSTOP,
            135, 112,  115, 68 

    DEFPUSHBUTTON "OK", IDOK,       277,  6, 45, 14, WS_GROUP
    PUSHBUTTON "Abbrechen", IDCANCEL,  277, 26, 45, 14, WS_GROUP

    PUSHBUTTON "&Hilfe", pshHelp,      277, 46, 45, 14, WS_GROUP
    CHECKBOX "&Schreibgeschützt", chx1,    255, 66, 68, 12,
                        BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP

END
