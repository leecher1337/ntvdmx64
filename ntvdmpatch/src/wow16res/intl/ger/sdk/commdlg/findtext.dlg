FINDDLGORD DIALOG LOADONCALL MOVEABLE DISCARDABLE
30, 73, 251, 64
CAPTION "Suchen"
STYLE WS_BORDER | WS_CAPTION | DS_MODALFRAME | WS_POPUP | WS_SYSMENU
FONT 8, "Helv"
BEGIN
    CONTROL "Suchen &nach:", -1, "static", SS_LEFT | WS_CHILD,
        4, 8, 47, 10
    CONTROL "", edt1, "edit", ES_LEFT | ES_AUTOHSCROLL | WS_BORDER | WS_GROUP |
            WS_TABSTOP | WS_CHILD | WS_BORDER,
        52, 6, 133, 12

    CONTROL "Nu&r ganzes Wort suchen", chx1, "button", BS_AUTOCHECKBOX |
            WS_TABSTOP | WS_CHILD | WS_GROUP,
        4, 32, 93, 12
    CONTROL "&Groﬂ-/Kleinschreibung", chx2, "button", BS_AUTOCHECKBOX | 
            WS_TABSTOP | WS_CHILD,
        4, 46, 85, 17

    CONTROL "Suchrichtung", grp1, "button", BS_GROUPBOX | WS_CHILD,
        105, 22, 80, 39
    CONTROL "Nach &oben", rad1, "button", BS_AUTORADIOBUTTON | 
            WS_TABSTOP | WS_CHILD | WS_GROUP,
         110, 32, 59, 12
    CONTROL "Nach &unten", rad2, "button", BS_AUTORADIOBUTTON | WS_TABSTOP |
            WS_CHILD,
         110, 46, 55, 12

    CONTROL "&Weitersuchen", IDOK, "button", BS_DEFPUSHBUTTON | WS_CHILD |
            WS_TABSTOP | WS_GROUP,
       191, 5, 54, 14
    CONTROL "Abbrechen", IDCANCEL, "button", BS_PUSHBUTTON | WS_CHILD | 
            WS_TABSTOP | WS_GROUP,
       191, 23, 54, 14
    CONTROL "&Hilfe", pshHelp, "button", BS_PUSHBUTTON | WS_CHILD |
            WS_TABSTOP | WS_GROUP,
       191, 45, 54, 14
END


