//---------------------------------------------------------------------------
// prnsetup.dlg : reconstructed ger resources
//
// Recovered from the shipped localized commdlg.dll with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------

PRINTDLGORD DIALOG LOADONCALL MOVEABLE DISCARDABLE 
36, 52,  221, 130
CAPTION "Drucken"
STYLE WS_CAPTION | WS_SYSMENU | WS_POPUP | DS_MODALFRAME
FONT 8, "Helv"
BEGIN
  LTEXT "Drucker:"  stc6, 4,    4,  28,   10
  LTEXT "Standarddrucker"  stc1, 34,   4, 130,  18
  GROUPBOX "Druckbereich", grp1, 4,   27,  132,  67
  RADIOBUTTON "&Alles" rad1, 10,  39,  76,  12,  WS_TABSTOP | WS_GROUP
  RADIOBUTTON "&Markierung" rad2, 10,  52,  76,  12
  RADIOBUTTON "&Seiten" rad3, 10,  65,  76,  12
  RTEXT "&Von:"  stc2, 24,  80,  24,   10,  WS_GROUP
  EDITTEXT edt1, 52,  78,  26,  12,  WS_TABSTOP | ES_RIGHT
  RTEXT "&Bis:"  stc3, 82,  80,  16,   10
  EDITTEXT edt2, 102,  78,  26,  12,  WS_TABSTOP | ES_RIGHT

  LTEXT "Dr&uckqualität:"  stc4, 4,  100,  46,   10
  COMBOBOX      cmb1, 55,  98,  81,  36,
              WS_TABSTOP | CBS_DROPDOWNLIST | WS_GROUP | WS_BORDER | WS_VSCROLL

  LTEXT "&Kopien:", stc5, 153, 100,  29,   10
  EDITTEXT, edt3, 184,  98,  26,  12,  WS_TABSTOP | ES_RIGHT

  CHECKBOX "Ausgabe in &Datei umleiten"   chx1,
          4,  113, 132,  12,  BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP
  CHECKBOX "Kopien sor&tieren"  chx2,
         153, 113,  66,  12,  BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP

  DEFPUSHBUTTON  "OK"  IDOK,     168,   4,  49,  14,  WS_GROUP
  PUSHBUTTON "Abbrechen"  IDCANCEL, 168,  21,  49,  14,  WS_GROUP

  PUSHBUTTON "&Einrichten..."  psh1,  168,  41,  49,  14,  WS_GROUP
  PUSHBUTTON "&Hilfe"   pshHelp,  168,  75,  49,  14,  WS_GROUP
END


PRNSETUPDLGORD DIALOG LOADONCALL MOVEABLE DISCARDABLE 30, 23, 326, 122
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Druckereinrichtung"
FONT 8, "Helv"
BEGIN
  GROUPBOX      "Drucker", grp3, 4, 6, 262, 66
  LTEXT         "(Kein Standarddrucker)", stc1, 18, 30, 246, 10
  RADIOBUTTON   "&Standarddrucker", rad3, 8, 16, 256, 12, WS_GROUP | WS_TABSTOP
  RADIOBUTTON   "Spezieller &Drucker:", rad4, 8, 42, 256, 12
  COMBOBOX      cmb1, 18, 56, 246, 80, CBS_DROPDOWNLIST | WS_GROUP |
                WS_BORDER | WS_VSCROLL
  GROUPBOX      "Orientierung", grp1, 4, 74, 91, 46
  ICON          "", ico1, 12, 92, 24, 16
  RADIOBUTTON   "Hoch&format", rad1, 40, 86, 53, 12, WS_GROUP | WS_TABSTOP
  RADIOBUTTON   "&Querformat", rad2, 40, 102, 53, 12
  GROUPBOX      "Papier", grp2, 100, 74, 166, 46, WS_GROUP
  LTEXT         "&Größe:", stc2, 104, 88, 26, 10
  COMBOBOX      cmb2, 134, 86, 130, 80, CBS_DROPDOWNLIST | WS_BORDER | 
                WS_VSCROLL | WS_TABSTOP
  LTEXT         "&Zufuhr:", stc3, 104, 104, 28, 10
  COMBOBOX      cmb3, 134, 102, 130, 80, CBS_DROPDOWNLIST | WS_BORDER | 
                WS_VSCROLL | WS_TABSTOP
  DEFPUSHBUTTON "OK", IDOK, 271, 4, 50, 14, WS_GROUP
  PUSHBUTTON    "Abbrechen", IDCANCEL, 271, 20, 50, 14, WS_GROUP
  PUSHBUTTON    "&Optionen...", psh1, 271, 40, 50, 14, WS_GROUP
  PUSHBUTTON    "&Hilfe", pshHelp, 271, 56, 50, 14, WS_GROUP
END

