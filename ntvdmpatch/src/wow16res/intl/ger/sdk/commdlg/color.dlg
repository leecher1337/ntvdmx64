//---------------------------------------------------------------------------
// color.dlg : reconstructed ger resources
//
// Recovered from the shipped localized commdlg.dll with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------
#include "colordlg.h"

ChooseColor DIALOG LOADONCALL MOVEABLE DISCARDABLE 2, 0, 298, 184
CAPTION "Farbe"
STYLE WS_BORDER | DS_MODALFRAME | WS_CAPTION | WS_POPUP | WS_SYSMENU
FONT 8 "Helv"
BEGIN
  LTEXT "Gr&undfarben:", -1, 4, 4, 140, 10

  CONTROL "", COLOR_BOX1, "static", SS_SIMPLE | WS_CHILD | WS_TABSTOP | WS_GROUP, 4, 14, 140, 86

  LTEXT "Benu&tzerdefinierte Farben:", -1, 4, 106, 140, 10

  CONTROL "",  COLOR_CUSTOM1, "static", SS_SIMPLE | WS_CHILD | WS_TABSTOP | WS_GROUP, 4, 116, 140, 28

  PUSHBUTTON "Farben &definieren..." COLOR_MIX, 4, 150, 140, 14, WS_TABSTOP | WS_GROUP

  DEFPUSHBUTTON "OK",      IDOK,  4, 166, 44, 14, WS_GROUP | WS_TABSTOP
  PUSHBUTTON "Abbrechen", IDCANCEL, 52, 166, 44, 14, WS_GROUP | WS_TABSTOP
  PUSHBUTTON "&Hilfe",  pshHelp, 100, 166, 44, 14, WS_GROUP | WS_TABSTOP

  CONTROL "",  COLOR_RAINBOW, "static", SS_BLACKFRAME | WS_CHILD, 152, 4, 118, 116

  CONTROL "",  COLOR_LUMSCROLL, "static", SS_SIMPLE | WS_CHILD, 278, 4, 8, 116

  CONTROL "", COLOR_CURRENT, "static", SS_BLACKFRAME | WS_CHILD, 152, 124, 40, 26

  PUSHBUTTON "&a", COLOR_SOLID, 300, 200, 4, 14, WS_GROUP

  RTEXT "Farbe |", -1, 144, 151, 28, 10

  LTEXT "E&infarbig", -1, 175, 151, 31, 10


  RTEXT "&Farbe:", COLOR_HUEACCEL, 202, 126, 22, 10

  EDITTEXT, COLOR_HUE, 226, 124, 18, 12, WS_GROUP | WS_TABSTOP

  RTEXT "&Sätt:", COLOR_SATACCEL, 202, 140, 22, 10

  EDITTEXT, COLOR_SAT, 226, 138, 18, 12, WS_GROUP | WS_TABSTOP

  RTEXT "H&ell:", COLOR_LUMACCEL, 202, 154, 22, 10

  EDITTEXT, COLOR_LUM, 226, 152, 18, 12, WS_GROUP | WS_TABSTOP

  RTEXT "&Rot:", COLOR_REDACCEL, 249, 126, 24, 10

  EDITTEXT, COLOR_RED, 275, 124, 18, 12, WS_GROUP | WS_TABSTOP

  RTEXT "&Grün:", COLOR_GREENACCEL, 249, 140, 24, 10

  EDITTEXT, COLOR_GREEN, 275, 138, 18, 12, WS_GROUP | WS_TABSTOP

  RTEXT "&Blau:", COLOR_BLUEACCEL, 249, 154, 24, 10

  EDITTEXT, COLOR_BLUE, 275, 152, 18, 12, WS_GROUP | WS_TABSTOP

  PUSHBUTTON "Farbe hin&zufügen", COLOR_ADD, 152, 166, 142, 14, WS_GROUP | WS_TABSTOP

END
