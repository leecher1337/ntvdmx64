FINDDLGORD DIALOG LOADONCALL MOVEABLE DISCARDABLE
30, 73, 280, 63
CAPTION "Znajdowanie"
STYLE WS_BORDER | WS_CAPTION | DS_MODALFRAME | WS_POPUP | WS_SYSMENU
FONT 8, "Helv"
BEGIN
    CONTROL "&ZnajdŸ:", -1, "static", SS_LEFT | WS_CHILD,
        4, 8, 42, 8
    CONTROL "", edt1, "edit", ES_LEFT | ES_AUTOHSCROLL | WS_BORDER | WS_GROUP |
            WS_TABSTOP | WS_CHILD | WS_BORDER,
        47, 7, 128, 12

    CONTROL "&Uwzglêdnij tylko ca³e wyrazy", chx1, "button", BS_AUTOCHECKBOX |
            WS_TABSTOP | WS_CHILD | WS_GROUP,
        4, 26, 111, 12
    CONTROL "Uwzglêdnij wi&elkoœæ liter", chx2, "button", BS_AUTOCHECKBOX | 
            WS_TABSTOP | WS_CHILD,
        4, 42, 97, 12

    CONTROL "Kierunek", grp1, "button", BS_GROUPBOX | WS_CHILD,
        120, 26, 87, 28
    CONTROL "&W górê", rad1, "button", BS_AUTORADIOBUTTON | 
            WS_TABSTOP | WS_CHILD | WS_GROUP,
         124, 38, 39, 12
    CONTROL "W &dó³", rad2, "button", BS_AUTORADIOBUTTON | WS_TABSTOP |
            WS_CHILD,
         165, 38, 36, 12

    CONTROL "ZnajdŸ &nastêpny", IDOK, "button", BS_DEFPUSHBUTTON | WS_CHILD |
            WS_TABSTOP | WS_GROUP,
       214, 5, 62, 14
    CONTROL "Anuluj", IDCANCEL, "button", BS_PUSHBUTTON | WS_CHILD | 
            WS_TABSTOP | WS_GROUP,
       214, 23, 62, 14
    CONTROL "Pomo&c", pshHelp, "button", BS_PUSHBUTTON | WS_CHILD |
            WS_TABSTOP | WS_GROUP,
       214, 45, 62, 14
END


