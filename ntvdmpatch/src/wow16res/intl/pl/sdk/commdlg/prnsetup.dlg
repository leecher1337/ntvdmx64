PRINTDLGORD DIALOG LOADONCALL MOVEABLE DISCARDABLE 
36, 52,  230, 130
CAPTION "Drukowanie"
STYLE WS_CAPTION | WS_SYSMENU | WS_POPUP | DS_MODALFRAME
FONT 8, "Helv"
BEGIN
  LTEXT "Drukarka:"  stc6, 4,    4,  40,   8
  LTEXT "Domyúlna systemowa"  stc1, 44,   4, 120,  18
  GROUPBOX "Zakres wydruku", grp1, 4,   27,  136,  67
  RADIOBUTTON "W&szystko" rad1, 10,  39,  76,  12,  WS_TABSTOP | WS_GROUP
  RADIOBUTTON "&Zaznaczenie" rad2, 10,  52,  76,  12
  RADIOBUTTON "St&rony" rad3, 10,  65,  76,  12
  RTEXT "&Od:"  stc2, 24,  80,  24,   9,  WS_GROUP
  EDITTEXT edt1, 52,  78,  26,  12,  WS_TABSTOP | ES_RIGHT
  RTEXT "&Do:"  stc3, 82,  80,  16,   9
  EDITTEXT edt2, 102,  78,  26,  12,  WS_TABSTOP | ES_RIGHT

  LTEXT "&JakoúÊ wydruku:"  stc4, 4,  100,  54,   9
  COMBOBOX      cmb1, 65,  98,  81,  36,
              WS_TABSTOP | CBS_DROPDOWNLIST | WS_GROUP | WS_BORDER | WS_VSCROLL

  LTEXT "Ko&pie:", stc5, 157, 100,  29,   9
  EDITTEXT, edt3, 190,  98,  26,  12,  WS_TABSTOP | ES_RIGHT

  CHECKBOX "Dr&ukuj do pliku"   chx1,
          4,  113, 120,  12,  BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP
  CHECKBOX "Sortuj &kopie"  chx2,
         157, 113,  68,  12,  BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP

  DEFPUSHBUTTON  "OK"  IDOK,     174,   4,  51,  14,  WS_GROUP
  PUSHBUTTON "Anuluj"  IDCANCEL, 174,  21,  51,  14,  WS_GROUP

  PUSHBUTTON "Us&tawienia..."  psh1,  174,  41,  51,  14,  WS_GROUP
  PUSHBUTTON "Pomo&c"   pshHelp,  174,  75,  51,  14,  WS_GROUP
END


PRNSETUPDLGORD DIALOG LOADONCALL MOVEABLE DISCARDABLE 30, 23, 287, 122
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Ustawienia wydruku"
FONT 8, "Helv"
BEGIN
