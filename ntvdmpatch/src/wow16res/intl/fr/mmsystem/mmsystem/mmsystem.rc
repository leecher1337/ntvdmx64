//---------------------------------------------------------------------------
// mmsystem.rc : reconstructed fr resources
//
// Recovered from the shipped localized mmsystem.dll with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------
#include <windows.h>

#define MMNOSOUND
#define MMNOSEQ
#define MMNOTIMER
#define MMNOJOY
#include "mmsystem.h"
#include "mmsystem.rcv"

#define NOTIMERDEV
#define NOJOYDEV
#define NOSEQDEV
#define NOTASKDEV
#include "mmddk.h"

#include "mmsysi.h"

