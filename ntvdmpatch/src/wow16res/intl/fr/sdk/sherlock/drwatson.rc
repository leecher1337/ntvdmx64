//---------------------------------------------------------------------------
// drwatson.rc : reconstructed fr resources
//
// Recovered from the shipped localized drwatson.exe with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------
#define NOGDICAPMASKS
#define NOWINMESSAGES
#define NOSYSMETRICS
#define NOICON
#define NOKEYSTATE
#define NOSYSCOMMANDS
#define NOSHOWWINDOW
#define NOATOM
#define NOGDI
#define NOFONT
#define NOBRUSH
#define NOCLIPBOARD
#define NOCOLOR
#define NOCREATESTRUCT
#define NODRAWTEXT
#define NOMB
#define NOMEMMGR
#define NOMETAFILE
#define NOMINMAX
#define NOOPENFILE
#define NOPEN
#define NOREGION
#define NOSCROLL
#define NOSOUND
#define NOTEXTMETRIC
#define NOWH
#define NOWINOFFSETS
#define NOWNDCLASS
#define NOCOMM
#include <windows.h>

#include "drwatson.rcv"

#include "str.h"

drwatsonIcon ICON doctor.ico

#define DS_3DLOOK           0x0004

SHERDIAG DIALOG DISCARDABLE LOADONCALL PURE MOVEABLE 59, 42, 179, 139
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME | DS_3DLOOK
CAPTION "Les indications du Dr Watson"
BEGIN
  CONTROL "Pour vous aider à résoudre le problème que vous venez de rencontrer, veuillez décrire ce que vous étiez en train de faire avant que l'erreur ne se produise." 101, "STATIC", WS_CHILD | WS_VISIBLE | 0x1L, 26, 5, 128, 42
  CONTROL "" 102, "EDIT", WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP | 0x44L, 14, 50, 151, 62
  CONTROL "OK" 1, "BUTTON", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 45, 119, 36, 14
  CONTROL "Annuler" 2, "BUTTON", WS_CHILD | WS_VISIBLE | WS_TABSTOP, 97, 119, 36, 14
END

STRINGTABLE PRELOAD DISCARDABLE
BEGIN

/* Note all strings below must be <= CCH_MAX_STRING_RESOURCE chars! */

/* drwatson.c */

IDSTRNoFault                           "Aucune erreur détectée\n\nCopyright 1991-1995, Microsoft Corp."
IDSTRFaulty                            "%d Vous trouverez de nouveaux rapports d'échec Dr Watson dans le fichier %s\n\nCopyright 1991-1995, Microsoft Corp."
IDSTRGPText                            "Une erreur s'est produite dans votre application.\nSi vous choisissez Ignorer, vous devriez enregistrer votre travail dans un nouveau fichier.\nSi vous choisissez Fermer, votre application s'arrêtera."
IDSTRErrMsg                            "Un exemplaire de Dr Watson est déjà en cours d'exécution sur votre ordinateur."
IDSTRVers                              "Impossible d'installer Dr Watson, la version de TOOLHELP.DLL n'est peut-être pas correcte"
IDSTRClassMsg                          "Impossible d'installer Dr Watson, la classe de la fenêtre ne peut pas être déterminée."
IDSTRCoprocessor                       "Coprocesseur mathématique"
IDSTR8086                              "8086"
