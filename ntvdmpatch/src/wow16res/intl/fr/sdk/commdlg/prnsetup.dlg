//---------------------------------------------------------------------------
// prnsetup.dlg : reconstructed fr resources
//
// Recovered from the shipped localized commdlg.dll with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------

PRINTDLGORD DIALOG LOADONCALL MOVEABLE DISCARDABLE 
36, 52,  225, 130
CAPTION "Impression"
STYLE WS_CAPTION | WS_SYSMENU | WS_POPUP | DS_MODALFRAME
FONT 8, "Helv"
BEGIN
  LTEXT "Imprimante :"  stc6, 4,    4,  40,   8
  LTEXT "Système par défaut"  stc1, 44,   4, 120,  18
  GROUPBOX "Zone d'impression", grp1, 4,   27,  132,  67
  RADIOBUTTON "&Tout" rad1, 10,  39,  76,  12,  WS_TABSTOP | WS_GROUP
  RADIOBUTTON "&Sélection" rad2, 10,  52,  76,  12
  RADIOBUTTON "&Pages" rad3, 10,  65,  76,  12
  RTEXT "&de :"  stc2, 24,  80,  24,   9,  WS_GROUP
  EDITTEXT edt1, 52,  78,  26,  12,  WS_TABSTOP | ES_RIGHT
  RTEXT "&à :"  stc3, 82,  80,  16,   9
  EDITTEXT edt2, 102,  78,  26,  12,  WS_TABSTOP | ES_RIGHT

  LTEXT "&Qualité :"  stc4, 4,  100,  35,   9
  COMBOBOX      cmb1, 40,  98,  96,  36,
              WS_TABSTOP | CBS_DROPDOWNLIST | WS_GROUP | WS_BORDER | WS_VSCROLL

  LTEXT "C&opies :", stc5, 147, 100,  29,   9
  EDITTEXT, edt3, 178,  98,  26,  12,  WS_TABSTOP | ES_RIGHT

  CHECKBOX "&Imprimer dans un fichier"   chx1,
          4,  113, 120,  12,  BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP
  CHECKBOX "Copi&es assemblées"  chx2,
         147, 113,  73,  12,  BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP

  DEFPUSHBUTTON  "OK"  IDOK,     170,   4,  50,  14,  WS_GROUP
  PUSHBUTTON "Annuler"  IDCANCEL, 170,  21,  50,  14,  WS_GROUP

  PUSHBUTTON "I&nstaller..."  psh1,  170,  41,  50,  14,  WS_GROUP
  PUSHBUTTON "&Aide"   pshHelp,  170,  75,  50,  14,  WS_GROUP
END


PRNSETUPDLGORD DIALOG LOADONCALL MOVEABLE DISCARDABLE 30, 23, 287, 122
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Configuration de l'impression"
FONT 8, "Helv"
BEGIN
  GROUPBOX      "Imprimante", grp3, 4, 6, 224, 66
  LTEXT         "(Pas d'imprimante par défaut)", stc1, 18, 30, 208, 9
  RADIOBUTTON   "Imprimante par &défaut", rad3, 8, 16, 218, 12, WS_GROUP | WS_TABSTOP
  RADIOBUTTON   "&Imprimante spécifique :", rad4, 8, 42, 218, 12
  COMBOBOX      cmb1, 18, 56, 208, 80, CBS_DROPDOWNLIST | WS_GROUP |
                WS_BORDER | WS_VSCROLL
  GROUPBOX      "Orientation", grp1, 4, 74, 91, 46
  ICON          "", ico1, 12, 92, 24, 16
  RADIOBUTTON   "Po&rtrait", rad1, 40, 86, 53, 12, WS_GROUP | WS_TABSTOP
  RADIOBUTTON   "&Paysage", rad2, 40, 102, 53, 12
  GROUPBOX      "Papier", grp2, 100, 74, 128, 46, WS_GROUP
  LTEXT         "&Taille :", stc2, 104, 88, 26, 9
  COMBOBOX      cmb2, 134, 86, 92, 80, CBS_DROPDOWNLIST | WS_BORDER | 
                WS_VSCROLL | WS_TABSTOP
  LTEXT         "&Source :", stc3, 104, 104, 28, 9
  COMBOBOX      cmb3, 134, 102, 92, 80, CBS_DROPDOWNLIST | WS_BORDER | 
                WS_VSCROLL | WS_TABSTOP
  DEFPUSHBUTTON "OK", IDOK, 232, 4, 50, 14, WS_GROUP
  PUSHBUTTON    "Annuler", IDCANCEL, 232, 20, 50, 14, WS_GROUP
  PUSHBUTTON    "&Options...", psh1, 232, 40, 50, 14, WS_GROUP
  PUSHBUTTON    "&Aide", pshHelp, 232, 56, 50, 14, WS_GROUP
END

