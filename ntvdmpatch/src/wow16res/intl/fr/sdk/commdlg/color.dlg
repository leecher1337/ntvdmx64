//---------------------------------------------------------------------------
// color.dlg : reconstructed fr resources
//
// Recovered from the shipped localized commdlg.dll with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------
#include "colordlg.h"

ChooseColor DIALOG LOADONCALL MOVEABLE DISCARDABLE 2, 0, 298, 184
CAPTION "Couleurs"
STYLE WS_BORDER | DS_MODALFRAME | WS_CAPTION | WS_POPUP | WS_SYSMENU
FONT 8 "Helv"
BEGIN
  LTEXT "&Couleurs de base :", -1, 4, 4, 140, 9

  CONTROL "", COLOR_BOX1, "static", SS_SIMPLE | WS_CHILD | WS_TABSTOP | WS_GROUP, 4, 14, 140, 86

  LTEXT "Couleurs &personnalisées :", -1, 4, 106, 140, 9

  CONTROL "",  COLOR_CUSTOM1, "static", SS_SIMPLE | WS_CHILD | WS_TABSTOP | WS_GROUP, 4, 116, 140, 28

  PUSHBUTTON "&Définir les couleurs personnalisées..." COLOR_MIX, 4, 150, 140, 14, WS_TABSTOP | WS_GROUP

  DEFPUSHBUTTON "OK",      IDOK,  4, 166, 44, 14, WS_GROUP | WS_TABSTOP
  PUSHBUTTON "Annuler", IDCANCEL, 52, 166, 44, 14, WS_GROUP | WS_TABSTOP
  PUSHBUTTON "&Aide",  pshHelp, 100, 166, 44, 14, WS_GROUP | WS_TABSTOP

  CONTROL "",  COLOR_RAINBOW, "static", SS_BLACKFRAME | WS_CHILD, 152, 4, 118, 116

  CONTROL "",  COLOR_LUMSCROLL, "static", SS_SIMPLE | WS_CHILD, 280, 4, 8, 116

  CONTROL "", COLOR_CURRENT, "static", SS_BLACKFRAME | WS_CHILD, 152, 124, 40, 26

  PUSHBUTTON "&o", COLOR_SOLID, 300, 200, 4, 14, WS_GROUP

  RTEXT "Couleur|", -1, 152, 151, 25, 9

  LTEXT "U&nie", -1, 178, 151, 15, 9


  RTEXT "&Teinte :", COLOR_HUEACCEL, 196, 126, 25, 9

  EDITTEXT, COLOR_HUE, 225, 124, 18, 12, WS_GROUP | WS_TABSTOP

  RTEXT "&Satur. :", COLOR_SATACCEL, 196, 140, 23, 9

  EDITTEXT, COLOR_SAT, 225, 138, 18, 12, WS_GROUP | WS_TABSTOP

  RTEXT "&Lum. :", COLOR_LUMACCEL, 199, 154, 20, 9

  EDITTEXT, COLOR_LUM, 225, 152, 18, 12, WS_GROUP | WS_TABSTOP

  RTEXT "&Rouge :", COLOR_REDACCEL, 247, 126, 26, 9

  EDITTEXT, COLOR_RED, 277, 124, 18, 12, WS_GROUP | WS_TABSTOP

  RTEXT "&Vert :", COLOR_GREENACCEL, 249, 140, 24, 9

  EDITTEXT, COLOR_GREEN, 277, 138, 18, 12, WS_GROUP | WS_TABSTOP

  RTEXT "&Bleu :", COLOR_BLUEACCEL, 249, 154, 24, 9

  EDITTEXT, COLOR_BLUE, 277, 152, 18, 12, WS_GROUP | WS_TABSTOP

  PUSHBUTTON "Ajo&uter aux couleurs personnalisées", COLOR_ADD, 153, 166, 142, 14, WS_GROUP | WS_TABSTOP

END
