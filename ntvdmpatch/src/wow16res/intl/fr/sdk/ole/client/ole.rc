//---------------------------------------------------------------------------
// ole.rc : reconstructed fr resources
//
// Recovered from the shipped localized olecli.dll with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------
#include <windows.h>

//----Version Stamping-------------------------------------------------------
#include "olecli.rcv"

CONNECTDLG DIALOG FIXED IMPURE  76, 55, 176, 77
STYLE DS_MODALFRAME | WS_POPUPWINDOW | WS_DLGFRAME
CAPTION "Connexion à un lecteur réseau"
BEGIN
	CONTROL "&Lecteur :",        -1, "STATIC", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP, 32, 5, 29, 8
	CONTROL "",               500, "COMBOBOX", CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP | WS_TABSTOP, 66, 3, 20, 40
	CONTROL "&Chemin réseau :", -1, "STATIC", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP, 9, 21, 52, 8
	CONTROL "",               502, "EDIT", ES_LEFT | ES_AUTOHSCROLL | ES_OEMCONVERT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_GROUP | WS_TABSTOP, 66, 20, 96, 12
	CONTROL "&Mot de passe :",     -1, "STATIC", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP, 13, 37, 48, 8
	CONTROL "",               501, "EDIT", ES_LEFT | ES_PASSWORD | ES_AUTOHSCROLL | ES_OEMCONVERT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_GROUP | WS_TABSTOP, 66, 35, 60, 12
	CONTROL "&Se connecter",       IDOK, "BUTTON", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 30, 54, 55, 14
	CONTROL "&Annuler",        IDCANCEL, "BUTTON", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 93, 54, 55, 14
END

STRINGTABLE
BEGIN
    600, "Erreur réseau"
    601, "Impossible de se connecter au lecteur réseau."
END
