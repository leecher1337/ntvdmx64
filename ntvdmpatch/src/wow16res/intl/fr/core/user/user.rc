//---------------------------------------------------------------------------
// user.rc : reconstructed fr resources
//
// Recovered from the shipped localized user.exe with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------
/****************************************************************************/
/*                                                                          */
/*  USER.RC -                                                               */
/*                                                                          */
/*  USER's Resource File                                                    */
/*                                                                          */
/****************************************************************************/

#include "strtable.h"
#include "netdlg.h"


STRINGTABLE PRELOAD DISCARDABLE
BEGIN

    STR_NETDRIVER       "NETWORK.DRV"
    STR_BOOT            "boot"
    STR_LANGDRIVER      "LANGUAGE.DLL"
    STR_SYSTEMINI       "SYSTEM.INI"
    STR_TASKMAN         "TASKMAN.EXE"
    STR_DRIVERS         "DRIVERS"

/* Strings used for device driver initialization which we don't want hanging
 * around our ds.
 */
    STR_COMMMODULENAME,     "COMM"
    STR_COMMWRITESTRING,    "COMMWRITESTRING"
    STR_COMMREADSTRING,     "READCOMMSTRING"
    STR_COMMENABLENOTIFICATION "ENABLENOTIFICATION"

/*---------------------------------------------------------------------------*/
/* All strings above this line MUST NOT be localized.  All strings below
 * this line should be localized.
 */
    STR_NETCONNTTL      "Erreur lors de la restauration des connexions réseau"
    STR_NETCONNMSG      "Impossible de se connecter à %s : %s"
    STR_NETCRASHEDTITLE     "Erreur lors de la restauration des connexions réseau"
    STR_NETCRASHEDMSG       "Windows a redémarré pendant la restauration des connexions réseau. Réessayer de rétablir les connexions ou annuler les connexions réseau pour cette session ?"

    STR_NETERRORS       "Erreur réseau inattendue : 0x%4.4X"
    STR_NETERRORS+1     "Fonction réseau non prise en charge"
    STR_NETERRORS+2     "Erreur réseau"
    STR_NETERRORS+6     "Mot de passe incorrect"
    STR_NETERRORS+7     "Accès refusé"
    STR_NETERRORS+11        "Mémoire insuffisante"
    STR_NETERRORS+0x30      "Périphérique non connecté"
    STR_NETERRORS+0x31      "Le périphérique a des fichiers ouverts"
    STR_NETERRORS+0x32      "Nom de réseau non valide"
    STR_NETERRORS+0x33      "Périphérique local non valide"
    STR_NETERRORS+0x34      "Périphérique déjà connecté"
    STR_NETERRORS+0x35      "La connexion est perdue"
    STR_NETERRORS+0x36      "Connexion permanente non disponible"

    STR_SYSERR,             "Erreur système"
    STR_DIVBYZERO,          "Division par zéro ou erreur de dépassement"

END

#include "user.rcv"
