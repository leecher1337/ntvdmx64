// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------
/****************************************************************************/
/*                                                                          */
/*  USER.RC -                                                               */
/*                                                                          */
/*  USER's Resource File                                                    */
/*                                                                          */
/****************************************************************************/

#include "strtable.h"
#include "netdlg.h"


STRINGTABLE PRELOAD DISCARDABLE
BEGIN

    STR_NETDRIVER       "NETWORK.DRV"
    STR_BOOT            "boot"
    STR_LANGDRIVER      "LANGUAGE.DLL"
    STR_SYSTEMINI       "SYSTEM.INI"
    STR_TASKMAN         "TASKMAN.EXE"
    STR_DRIVERS         "DRIVERS"

/* Strings used for device driver initialization which we don't want hanging
 * around our ds.
 */
    STR_COMMMODULENAME,     "COMM"
    STR_COMMWRITESTRING,    "COMMWRITESTRING"
    STR_COMMREADSTRING,     "READCOMMSTRING"
    STR_COMMENABLENOTIFICATION "ENABLENOTIFICATION"

/*---------------------------------------------------------------------------*/
/* All strings above this line MUST NOT be localized.  All strings below
 * this line should be localized.
 */
    STR_NETCONNTTL      "Παρουσιάστηκε σφάλμα κατά την επαναφορά των συνδέσεων με το δίκτυο"
    STR_NETCONNMSG      "Αδύνατη η σύνδεση με %s: %s"
    STR_NETCRASHEDTITLE     "Παρουσιάστηκε σφάλμα κατά την επαναφορά των συνδέσεων με το δίκτυο"
    STR_NETCRASHEDMSG       "Τα Windows ξεκίνησαν ξανά κατά την επαναφορά των συνδέσεων με το δίκτυο. Προσπαθήστε πάλι να πραγματοποιήσετε σύνδεση με το δίκτυο ή ακυρώστε τη σύνδεση με το δίκτυο για αυτήν την λειτουργία."

    STR_NETERRORS       "Παρουσιάστηκε μη αναμενόμενο  σφάλμα δικτύου: 0x%4.4X"
    STR_NETERRORS+1     "Η λειτουργία του δικτύου δεν υποστηρίζεται"
    STR_NETERRORS+2     "Σφάλμα δικτύου"
    STR_NETERRORS+6     "Ο κωδικός πρόσβασης δεν είναι έγκυρος"
    STR_NETERRORS+7     "Δεν επιτρέπεται η πρόσβαση"
    STR_NETERRORS+11        "Η μνήμη δεν επαρκεί"
    STR_NETERRORS+0x30      "Η συσκευή δεν είναι συνδεδεμένη"
    STR_NETERRORS+0x31      "Υπάρχουν ανοιχτά αρχεία στη συσκευή"
    STR_NETERRORS+0x32      "Το όνομα του δικτύου δεν είναι έγκυρο"
    STR_NETERRORS+0x33      "Η τοπική συσκευή δεν είναι έγκυρη"
    STR_NETERRORS+0x34      "Η συσκευή είναι ήδη συνδεδεμένη"
    STR_NETERRORS+0x35      "Η σύνδεση διακόπηκε"
    STR_NETERRORS+0x36      "Η μόνιμη σύνδεση δεν είναι διαθέσιμη"

    STR_SYSERR,             "Σφάλμα συστήματος"
    STR_DIVBYZERO,          "Διαίρεση με το μηδέν ή σφάλμα υπερχείλισης"

END

#include "user.rcv"
