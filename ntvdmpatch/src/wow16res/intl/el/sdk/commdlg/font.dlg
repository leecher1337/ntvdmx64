//---------------------------------------------------------------------------
// font.dlg : reconstructed el resources
//
// Recovered from the shipped localized commdlg.dll with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------

FORMATDLGORD31 DIALOG 13, 54, 309, 178
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Γραμματοσειρά"
FONT 8, "Helv"
BEGIN
    LTEXT           "&Γραμματοσειρά:", stc1, 6, 3, 91, 8
    COMBOBOX        cmb1, 6, 20, 99, 76, CBS_SIMPLE | CBS_AUTOHSCROLL | CBS_SORT | WS_VSCROLL | WS_TABSTOP | CBS_HASSTRINGS | CBS_OWNERDRAWFIXED | CBS_DISABLENOSCROLL

    LTEXT           "&Στυλ:", stc2, 116, 3, 44, 9
    COMBOBOX        cmb2, 113, 20, 99, 76, CBS_SIMPLE | WS_VSCROLL | CBS_DISABLENOSCROLL | WS_TABSTOP

    LTEXT           "&Μέγεθος:", stc3, 216, 3, 36, 8
    COMBOBOX        cmb3, 218, 20, 32, 76, CBS_SIMPLE | WS_VSCROLL | WS_TABSTOP | CBS_HASSTRINGS | CBS_OWNERDRAWFIXED | CBS_SORT | CBS_DISABLENOSCROLL

    DEFPUSHBUTTON   "ΟΚ", IDOK, 264, 13, 40, 14, WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "’κυρο", IDCANCEL, 264, 30, 40, 14, WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "Ε&φαρμογή", psh3, 264, 47, 40, 14, WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "&Βοήθεια", pshHelp, 264, 64, 40, 14, WS_GROUP | WS_TABSTOP

    GROUPBOX        "Εφέ", grp1, 6, 106, 86, 34, WS_GROUP
    CONTROL         "&Διακριτή διαγραφή", chx1, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 116, 79, 10
    CONTROL         "&Υπογράμμιση", chx2, "Button", BS_AUTOCHECKBOX, 10, 128, 79, 10

    LTEXT           "&Χρώμα:", stc4, 6, 144, 85, 8
    COMBOBOX        cmb4, 6, 154, 99, 100, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_AUTOHSCROLL | CBS_HASSTRINGS | WS_BORDER | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Δείγμα", grp2, 113, 106, 160, 49, WS_GROUP
    CTEXT           "", stc6, 113, 156, 160, 20,  SS_NOPREFIX | NOT WS_GROUP
    CTEXT           "AaBbYyZz", stc5, 104, 81, 149, 37, SS_NOPREFIX | NOT WS_VISIBLE
END

