/********************************************************************/
/*                                                                  */
/*  COMMDLG.RCV                                                     */
/*                                                                  */
/*  This RC fragment shows how to define version information in an  */
/*  internal RC file                                                */
/*                                                                  */
/*  It relies upon both the public VER.H and private VERSION.H      */
/*                                                                  */
/********************************************************************/

#include <version.h>

/*-----------------------------------------------*/
/* the following lines are specific to this file */
/*-----------------------------------------------*/

#define VER_FILETYPE                VFT_DLL
#define VER_FILESUBTYPE             VFT2_UNKNOWN
#define VER_INTERNALNAME_STR        "COMMDLG"
#define VER_ORIGINALFILENAME_STR    "COMMDLG.DLL"

/*-------------------------------------------------*/
/* localized strings and language of this resource */
/*-------------------------------------------------*/
#undef VER_FILEDESCRIPTION_STR
#define VER_FILEDESCRIPTION_STR     "Βιβλιοθήκες κοινών παραθύρων διαλόγου"
#undef VER_PRODUCTNAME_STR
#define VER_PRODUCTNAME_STR         "Λειτουργικό σύστημα Microsoft® Windows(TM)\0"
#undef VER_LEGALCOPYRIGHT_STR
#define VER_LEGALCOPYRIGHT_STR      "Πνευματικά δικαιώματα © Microsoft Corporation 1981-1996"
#define VER_LANGID                  0x0408
#define VER_CHARSETID               0x04E5
#define VER_STRINGFILEINFO_BLOCK    "040804E5"

#include <common.ver>
