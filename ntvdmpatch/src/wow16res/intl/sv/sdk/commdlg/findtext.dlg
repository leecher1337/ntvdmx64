//---------------------------------------------------------------------------
// findtext.dlg : reconstructed sv resources
//
// Recovered from the shipped localized commdlg.dll with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------

FINDDLGORD DIALOG LOADONCALL MOVEABLE DISCARDABLE
30, 73, 260, 63
CAPTION "Sök"
STYLE WS_BORDER | WS_CAPTION | DS_MODALFRAME | WS_POPUP | WS_SYSMENU
FONT 8, "Helv"
BEGIN
    CONTROL "S&ök efter:", -1, "static", SS_LEFT | WS_CHILD,
        4, 8, 36, 8
    CONTROL "", edt1, "edit", ES_LEFT | ES_AUTOHSCROLL | WS_BORDER | WS_GROUP |
            WS_TABSTOP | WS_CHILD | WS_BORDER,
        41, 7, 159, 12

    CONTROL "Matcha hela &ord", chx1, "button", BS_AUTOCHECKBOX |
            WS_TABSTOP | WS_CHILD | WS_GROUP,
        4, 26, 119, 12
    CONTROL "&Matcha gemener/VERSALER", chx2, "button", BS_AUTOCHECKBOX | 
            WS_TABSTOP | WS_CHILD,
        4, 42, 119, 12

    CONTROL "Sökriktning", grp1, "button", BS_GROUPBOX | WS_CHILD,
        127, 26, 73, 28
    CONTROL "&Upp", rad1, "button", BS_AUTORADIOBUTTON | 
            WS_TABSTOP | WS_CHILD | WS_GROUP,
         131, 38, 32, 12
    CONTROL "Ne&d", rad2, "button", BS_AUTORADIOBUTTON | WS_TABSTOP |
            WS_CHILD,
         164, 38, 32, 12

    CONTROL "Sök &nästa", IDOK, "button", BS_DEFPUSHBUTTON | WS_CHILD |
            WS_TABSTOP | WS_GROUP,
       205, 5, 50, 14
    CONTROL "Avbryt", IDCANCEL, "button", BS_PUSHBUTTON | WS_CHILD | 
            WS_TABSTOP | WS_GROUP,
       205, 23, 50, 14
    CONTROL "&Hjälp", pshHelp, "button", BS_PUSHBUTTON | WS_CHILD |
            WS_TABSTOP | WS_GROUP,
       205, 45, 50, 14
END


REPLACEDLGORD DIALOG LOADONCALL MOVEABLE DISCARDABLE
36, 44, 230, 94
CAPTION "Ersätt"
STYLE WS_BORDER | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME | WS_POPUP
FONT 8, "Helv"
BEGIN
    CONTROL "S&ök efter:", -1, "static", SS_LEFT | WS_CHILD,
        4, 9, 48, 8
    CONTROL "", edt1, "edit", ES_LEFT | ES_AUTOHSCROLL | WS_BORDER | 
            WS_TABSTOP | WS_CHILD | WS_GROUP,
        57, 7, 114, 12
    CONTROL "Ers&ätt med:", -1, "static", SS_LEFT | WS_CHILD,
        4, 26, 48, 8
    CONTROL "", edt2, "edit", ES_LEFT | ES_AUTOHSCROLL | WS_BORDER |
            WS_TABSTOP | WS_CHILD | WS_GROUP,
        57, 24, 114, 12

    CONTROL "Matcha hela &ord", chx1, "button", BS_AUTOCHECKBOX |
            WS_TABSTOP | WS_CHILD | WS_GROUP,
        5, 46, 152, 12
    CONTROL "&Matcha gemener/VERSALER", chx2, "button", BS_AUTOCHECKBOX | WS_TABSTOP 
            | WS_CHILD,
        5, 62, 152, 12

    CONTROL "Sök &nästa", IDOK, "button", BS_DEFPUSHBUTTON | WS_CHILD |
            WS_TABSTOP | WS_GROUP,
        174, 4, 50, 14
    CONTROL "&Ersätt", psh1, "button", BS_PUSHBUTTON | WS_CHILD | 
            WS_TABSTOP | WS_GROUP,
        174, 21, 50, 14
    CONTROL "Ersätt &alla", psh2, "button", BS_PUSHBUTTON | WS_CHILD | 
            WS_TABSTOP | WS_GROUP,
        174, 38, 50, 14
    CONTROL "Avbryt", IDCANCEL, "button", BS_PUSHBUTTON | WS_CHILD |
            WS_TABSTOP | WS_GROUP,
        174, 55, 50, 14
    CONTROL "&Hjälp", pshHelp, "button", BS_PUSHBUTTON | WS_CHILD |
            WS_TABSTOP | WS_GROUP,
        174, 75, 50, 14

END
