//---------------------------------------------------------------------------
// ole.rc : reconstructed sv resources
//
// Recovered from the shipped localized olecli.dll with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------
#include <windows.h>

//----Version Stamping-------------------------------------------------------
#include "olecli.rcv"

CONNECTDLG DIALOG FIXED IMPURE  76, 55, 155, 76
STYLE DS_MODALFRAME | WS_POPUPWINDOW | WS_DLGFRAME
CAPTION "Anslut nätverksenhet"
BEGIN
	CONTROL "&Enhet:",        -1, "STATIC", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP, 20, 7, 40, 9
	CONTROL "",               500, "COMBOBOX", CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP | WS_TABSTOP, 64, 3, 33, 40
	CONTROL "&Nätverkssökväg:", -1, "STATIC", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP, 4, 21, 56, 8
	CONTROL "",               502, "EDIT", ES_LEFT | ES_AUTOHSCROLL | ES_OEMCONVERT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_GROUP | WS_TABSTOP, 64, 20, 85, 12
	CONTROL "&Lösenord:",     -1, "STATIC", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP, 24, 37, 36, 10
	CONTROL "",               501, "EDIT", ES_LEFT | ES_PASSWORD | ES_AUTOHSCROLL | ES_OEMCONVERT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_GROUP | WS_TABSTOP, 64, 35, 60, 12
	CONTROL "An&slut",       IDOK, "BUTTON", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 26, 55, 42, 14
	CONTROL "&Avbryt",        IDCANCEL, "BUTTON", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 94, 55, 43, 14
END

STRINGTABLE
BEGIN
    600, "Nätverksfel"
    601, "Det gick inte att ansluta till nätverksenheten."
END
