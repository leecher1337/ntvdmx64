STRINGTABLE LOADONCALL MOVEABLE DISCARDABLE
BEGIN
	1,		"Timer-drivrutin"
	2,		"Det gick inte att hitta VTDAPI.386 filen. Det finns inga timers tillgängliga.\nKontrollera att VTDAPI.386 finns i Windows systemkatalog och att\nraden enhet=VTDAPI.386 finns med i (386Enh) sektionen av SYSTEM.INI-filen."
END
