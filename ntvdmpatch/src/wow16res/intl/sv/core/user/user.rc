//---------------------------------------------------------------------------
// user.rc : reconstructed sv resources
//
// Recovered from the shipped localized user.exe with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------
/****************************************************************************/
/*                                                                          */
/*  USER.RC -                                                               */
/*                                                                          */
/*  USER's Resource File                                                    */
/*                                                                          */
/****************************************************************************/

#include "strtable.h"
#include "netdlg.h"


STRINGTABLE PRELOAD DISCARDABLE
BEGIN

    STR_NETDRIVER       "NETWORK.DRV"
    STR_BOOT            "boot"
    STR_LANGDRIVER      "LANGUAGE.DLL"
    STR_SYSTEMINI       "SYSTEM.INI"
    STR_TASKMAN         "TASKMAN.EXE"
    STR_DRIVERS         "DRIVERS"

/* Strings used for device driver initialization which we don't want hanging
 * around our ds.
 */
    STR_COMMMODULENAME,     "COMM"
    STR_COMMWRITESTRING,    "COMMWRITESTRING"
    STR_COMMREADSTRING,     "READCOMMSTRING"
    STR_COMMENABLENOTIFICATION "ENABLENOTIFICATION"

/*---------------------------------------------------------------------------*/
/* All strings above this line MUST NOT be localized.  All strings below
 * this line should be localized.
 */
    STR_NETCONNTTL      "Fel vid återställning av nätverksanslutningar."
    STR_NETCONNMSG      "Kan inte ansluta till %s: %s"
    STR_NETCRASHEDTITLE     "Fel vid återställning av nätverksanslutningar."
    STR_NETCRASHEDMSG       "Windows startades om medan nätverksanslutningarna återställdes. Vill du återställa dem eller avbryta nätverksanslutningarna för den här sessionen?"

    STR_NETERRORS       "Ett okänt nätverksfel inträffade: 0x%4.4X"
    STR_NETERRORS+1     "Nätverksfunktionen stöds inte."
    STR_NETERRORS+2     "Nätverksfel"
    STR_NETERRORS+6     "Felaktigt lösenord"
    STR_NETERRORS+7     "Åtkomst nekad"
    STR_NETERRORS+11        "Det finns inget ledigt minne"
    STR_NETERRORS+0x30      "Enheten är inte ansluten"
    STR_NETERRORS+0x31      "Enheten har öppna filer"
    STR_NETERRORS+0x32      "Ogiltigt nätverksnamn"
    STR_NETERRORS+0x33      "Ogiltig lokal enhet"
    STR_NETERRORS+0x34      "Enheten är redan ansluten"
    STR_NETERRORS+0x35      "Anslutningen har avbrutits"
    STR_NETERRORS+0x36      "Permanent anslutning är inte tillgänglig"

    STR_SYSERR,             "Systemfel"
    STR_DIVBYZERO,          "Ett nolldivisionsfel eller ett dataspillsfel uppstod"

END

#include "user.rcv"
