/********************************************************************/
/*     OLECLI.RCV                                                   */
/********************************************************************/
#include <version.h>

#define VER_FILETYPE                    VFT_DLL
#define VER_FILESUBTYPE                 VFT2_UNKNOWN
#define VER_INTERNALNAME_STR            "OLECLI"
#define VER_ORIGINALFILENAME_STR        "OLECLI.DLL"
#define VER_FILEVERSION_STR             "1.20.000"
#undef  VER_COMPANYNAME_STR
#define VER_COMPANYNAME_STR             "Microsoft Corporation"

/*
 * olecli.dll is not built by the WOW16 build and its version resource says
 * so: OLE's own file version 1.20.000 (the minor field is packed BCD, so
 * 0x20 for .20), OLE's product version 3.10.101 with a trailing blank in the
 * string, a final-build FILEFLAGS, no "WOW Version" value and a single NUL
 * after CompanyName - version.h spells that macro with a NUL of its own,
 * which common.ver's VALUE line then doubles, so it is redefined without one
 * above.  common.ver can produce none of this, so the block is written out
 * here instead of being included.  All 15 shipped localized binaries agree on
 * every value below; only the strings a localized .rcv redefines differ per
 * language - and the Russian olecli.dll is the one binary in the whole tree
 * that localizes CompanyName.
 */
/*-------------------------------------------------*/
/* localized strings and language of this resource */
/*-------------------------------------------------*/
#undef VER_FILEDESCRIPTION_STR
#define VER_FILEDESCRIPTION_STR     "Client-DLL-bestand voor het koppelen en insluiten van objecten (OLE)\0\0\0"
#undef VER_PRODUCTNAME_STR
#define VER_PRODUCTNAME_STR         "Microsoft OLE-DLL-bestand voor Windows\031"
#undef VER_LEGALCOPYRIGHT_STR
#define VER_LEGALCOPYRIGHT_STR      "Copyright © Microsoft Corp. 1991-1993"
#define VER_LANGID                  0x0413
#define VER_CHARSETID               0x04E4
#define VER_STRINGFILEINFO_BLOCK    "041304E4"

#ifdef RC_INVOKED

VS_VERSION_INFO VERSIONINFO
FILEVERSION    1,0x20,0,0
PRODUCTVERSION 3,10,0,101
FILEFLAGSMASK  VER_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VER_FILEOS
FILETYPE       VER_FILETYPE
FILESUBTYPE    VER_FILESUBTYPE
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK VER_STRINGFILEINFO_BLOCK
        BEGIN
            VALUE "CompanyName",     VER_COMPANYNAME_STR, "\0"
            VALUE "FileDescription", VER_FILEDESCRIPTION_STR, "\0"
            VALUE "FileVersion",     VER_FILEVERSION_STR, "\0"
            VALUE "InternalName",    VER_INTERNALNAME_STR, "\0"
            VALUE "LegalCopyright",  VER_LEGALCOPYRIGHT_STR, "\0"
            VALUE "OriginalFilename",VER_ORIGINALFILENAME_STR, "\0"
            VALUE "ProductName",     VER_PRODUCTNAME_STR, "\0"
            VALUE "ProductVersion",  "3.10 ", "\0"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", VER_LANGID, VER_CHARSETID
    END
END

#endif
