//---------------------------------------------------------------------------
// drwatson.rc : reconstructed nl resources
//
// Recovered from the shipped localized drwatson.exe with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------
#define NOGDICAPMASKS
#define NOWINMESSAGES
#define NOSYSMETRICS
#define NOICON
#define NOKEYSTATE
#define NOSYSCOMMANDS
#define NOSHOWWINDOW
#define NOATOM
#define NOGDI
#define NOFONT
#define NOBRUSH
#define NOCLIPBOARD
#define NOCOLOR
#define NOCREATESTRUCT
#define NODRAWTEXT
#define NOMB
#define NOMEMMGR
#define NOMETAFILE
#define NOMINMAX
#define NOOPENFILE
#define NOPEN
#define NOREGION
#define NOSCROLL
#define NOSOUND
#define NOTEXTMETRIC
#define NOWH
#define NOWINOFFSETS
#define NOWNDCLASS
#define NOCOMM
#include <windows.h>

#include "drwatson.rcv"

#include "str.h"

drwatsonIcon ICON doctor.ico

#define DS_3DLOOK           0x0004

SHERDIAG DIALOG DISCARDABLE LOADONCALL PURE MOVEABLE 59, 42, 179, 139
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME | DS_3DLOOK
CAPTION "Dr. Watson's aanwijzingen"
BEGIN
  CONTROL "U kunt bij het oplossen van het zojuist opgetreden probleem behulpzaam zijn door een beschrijving te geven van de handelingen die u uitvoerde voordat de fout optrad." 101, "STATIC", WS_CHILD | WS_VISIBLE | 0x1L, 15, 5, 146, 34
  CONTROL "" 102, "EDIT", WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP | 0x44L, 13, 42, 151, 62
  CONTROL "OK" 1, "BUTTON", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 31, 119, 50, 14
  CONTROL "Annuleren" 2, "BUTTON", WS_CHILD | WS_VISIBLE | WS_TABSTOP, 97, 119, 50, 14
END

STRINGTABLE PRELOAD DISCARDABLE
BEGIN

/* Note all strings below must be <= CCH_MAX_STRING_RESOURCE chars! */

/* drwatson.c */

IDSTRNoFault                           "Geen fouten gevonden\n\nCopyright 1991-1995, Microsoft Corp."
