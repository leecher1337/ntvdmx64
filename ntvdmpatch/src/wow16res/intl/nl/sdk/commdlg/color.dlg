//---------------------------------------------------------------------------
// color.dlg : reconstructed nl resources
//
// Recovered from the shipped localized commdlg.dll with ntvdmpatch\src\wow16res,
// using messages\usa as the template.  Strings, captions and control
// geometry come from the binary; symbol names and layout from usa.
//---------------------------------------------------------------------------
#include "colordlg.h"

ChooseColor DIALOG LOADONCALL MOVEABLE DISCARDABLE 2, 0, 298, 184
CAPTION "Kleur"
STYLE WS_BORDER | DS_MODALFRAME | WS_CAPTION | WS_POPUP | WS_SYSMENU
FONT 8 "Helv"
BEGIN
  LTEXT "&Basiskleuren:", -1, 4, 4, 140, 9

  CONTROL "", COLOR_BOX1, "static", SS_SIMPLE | WS_CHILD | WS_TABSTOP | WS_GROUP, 4, 14, 140, 86

  LTEXT "Aang&epaste kleuren:", -1, 4, 106, 140, 9

  CONTROL "",  COLOR_CUSTOM1, "static", SS_SIMPLE | WS_CHILD | WS_TABSTOP | WS_GROUP, 4, 116, 140, 28

  PUSHBUTTON "&Aangepaste kleuren definiëren..." COLOR_MIX, 4, 150, 140, 14, WS_TABSTOP | WS_GROUP

  DEFPUSHBUTTON "OK",      IDOK,  4, 166, 44, 14, WS_GROUP | WS_TABSTOP
  PUSHBUTTON "Annuleren", IDCANCEL, 52, 166, 44, 14, WS_GROUP | WS_TABSTOP
  PUSHBUTTON "&Help",  pshHelp, 100, 166, 44, 14, WS_GROUP | WS_TABSTOP

  CONTROL "",  COLOR_RAINBOW, "static", SS_BLACKFRAME | WS_CHILD, 152, 4, 118, 116

  CONTROL "",  COLOR_LUMSCROLL, "static", SS_SIMPLE | WS_CHILD, 280, 4, 8, 116

  CONTROL "", COLOR_CURRENT, "static", SS_BLACKFRAME | WS_CHILD, 152, 124, 40, 26

  PUSHBUTTON "&o", COLOR_SOLID, 300, 200, 4, 14, WS_GROUP

  RTEXT "Kleur|", -1, 152, 151, 20, 9

  LTEXT "E&ffen", -1, 172, 151, 20, 9


  RTEXT "&Tint:", COLOR_HUEACCEL, 209, 126, 20, 9

  EDITTEXT, COLOR_HUE, 230, 124, 18, 12, WS_GROUP | WS_TABSTOP

  RTEXT "&Intensiteit:", COLOR_SATACCEL, 197, 140, 32, 9

  EDITTEXT, COLOR_SAT, 230, 138, 18, 12, WS_GROUP | WS_TABSTOP

  RTEXT "Hel&derheid:", COLOR_LUMACCEL, 192, 154, 37, 9

  EDITTEXT, COLOR_LUM, 230, 152, 18, 12, WS_GROUP | WS_TABSTOP

  RTEXT "&Rood:", COLOR_REDACCEL, 250, 126, 24, 9

  EDITTEXT, COLOR_RED, 275, 124, 18, 12, WS_GROUP | WS_TABSTOP

  RTEXT "&Groen:", COLOR_GREENACCEL, 250, 140, 24, 9

  EDITTEXT, COLOR_GREEN, 275, 138, 18, 12, WS_GROUP | WS_TABSTOP

  RTEXT "B&lauw:", COLOR_BLUEACCEL, 250, 154, 24, 9

  EDITTEXT, COLOR_BLUE, 275, 152, 18, 12, WS_GROUP | WS_TABSTOP

  PUSHBUTTON "Aan aangepaste kleuren toe&voegen", COLOR_ADD, 152, 166, 144, 14, WS_GROUP | WS_TABSTOP

END
