106a107,134
> /*
> ** Console hands-off.
> **
> ** TRUE when we must not touch this console's presentation state - its screen
> ** buffer size, the cursor position or the cursor shape.  Our own output is
> ** redirected, so some other process - eg the win32 stage of the same pipeline -
> ** is what the user is actually looking at, and conditioning the console for a
> ** guest that is not displaying anything only destroys that process's output.
> **
> ** Set NTVDM_BUF_RESIZE=1 to get the old unconditional behaviour back for an A/B.
> ** (The variable name is historical; it now covers the cursor as well.)
> */
> GLOBAL BOOL host_console_hands_off(VOID)
> {
>     static BOOL checked = FALSE;
>     static BOOL enabled = TRUE;
> 
>     if (!checked)
>     {
>         char *env;
> 
>         checked = TRUE;
>         if ((env = host_getenv("NTVDM_BUF_RESIZE")) != NULL && *env != '0')
>             enabled = FALSE;
>     }
>     return enabled && stdoutRedirected;
> }
> 
