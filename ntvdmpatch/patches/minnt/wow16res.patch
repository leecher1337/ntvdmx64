> all:   $(NAME).$(LANG)
> !ENDIF
109a114,121
> #international mods
> #note INTL_SRC, INTL_EXE and LANG are external macros set by international.
> #only mmsystem\mmtask was ever part of the international build, so the
> #mmsystem\mmsystem sub-path is ours; the resources are recovered from the
> #shipped localized mmsystem.dll by ntvdmpatch\src\wow16res.  mci.rc is the
> #MCI command table and says DO NOT LOCALIZE, but it is copied from RES_DIR
> #like the rest, so the recovered tree carries it unchanged.
> !IFNDEF LANG
110a123,126
> !ELSE
> RES_DIR =$(INTL_SRC)\$(LANG)\mmsystem\mmsystem
> EXE_DIR =$(INTL_EXE)
> !ENDIF
123a140,145
> 
> !IFDEF LANG
> $(NAME).$(LANG): $(NAME).res
>         copy $(EXE_DIR)\$(NAME).$(EXT) $(NAME).$(LANG)
>         $(RC) -t $(NAME).res $(NAME).$(LANG)
> !ENDIF
