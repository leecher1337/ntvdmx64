> //
> // W32Is16CodeSelCallable -- can the 16-bit code far-pointer in Address
> // (selector:offset) actually be called, or would loading its selector into CS
> // fault? Reads the REAL LDT descriptor via ExpLdt -- unlike GetPModeVDMPointer /
> // FlatAddress, which keep a stale base after a selector is freed and therefore
> // still report a freed wndproc as "valid". Returns TRUE when the selector's
> // descriptor is present, OR is a not-present-but-otherwise-valid CODE segment
> // (a discardable segment: the far-call's #NP will demand-reload it). Returns
> // FALSE only when the descriptor is neither present nor a valid code segment
> // (freed / zeroed / reallocated to non-code) -- i.e. calling it would GP-fault.
> // Used by W32Win16WndProcEx to avoid dispatching to a wndproc whose module was
> // freed at teardown (Lotus LSIRUN "KRNL386.EXE 0001:AEFF" crash: err_code was
> // the wndproc's own now-freed selector). Descriptor high-DWORD bits: 0x8000=P,
> // 0x1000=S(code/data), 0x0800=executable(code).
> //
> BOOL FASTCALL W32Is16CodeSelCallable(DWORD Address)
> {
>     ULONG desc;
> 
>     if (!ExpLdt) {
>         return TRUE;                    // can't check -> don't change behavior
>     }
>     desc = (ExpLdt)[(Address >> 18) | 1];
>     if (desc & LDT_DESC_PRESENT) {
>         return TRUE;                    // present
>     }
>     return ((desc & 0x1000) && (desc & 0x0800)) ? TRUE : FALSE; // discardable code seg?
> }
> #endif // W10
