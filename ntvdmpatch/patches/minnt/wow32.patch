1239a1253,1397
> 
> 
> #ifdef W10
> //*****************************************************************************
> // Emulated WH_JOURNALPLAYBACK driver (modern Windows blocks the real hook).
> //
> // W32JournalPlaybackActive - is an emulated playback hook currently installed?
> // W32PumpJournalPlayback   - call the 16-bit playback proc; nCode HC_GETNEXT
> //                            fills *lpEvt with the next event and returns the
> //                            delay (ms) before it should play; HC_SKIP (lpEvt
> //                            NULL) advances to the following event. Reuses the
> //                            existing ThunkJournalHook marshalling; USER32 used
> //                            to make these same calls.
> //*****************************************************************************
> 
> BOOL W32JournalPlaybackActive(VOID)
> {
>     return (gW10JournalHookIdx >= 0 &&
>             gW10JournalHookIdx < vaHookPPData.cHookProcs &&
>             vaHookStateData[gW10JournalHookIdx].InUse &&
>             vaHookStateData[gW10JournalHookIdx].iHook == WH_JOURNALPLAYBACK);
> }
> 
> LONG W32PumpJournalPlayback(INT nCode, LPEVENTMSG lpEvt)
> {
>     if (!W32JournalPlaybackActive())
>         return -1;
> 
>     return ThunkJournalHook(nCode, 0, lpEvt,
>                             &vaHookStateData[gW10JournalHookIdx]);
> }
> 
> //*****************************************************************************
> // W32JournalPlaybackOwnedByCurrentTask - TRUE only when an emulated playback
> // hook is active AND the calling task is the one that installed it. The pump
> // (WU32PeekMessage) must fire only for the owner: now that we inject events
> // (see W32InjectJournalEvent), letting some OTHER task's idle PeekMessage
> // fetch+HC_SKIP an event would consume it without injecting -> lost input.
> // The owner is the app sitting in the playback-wait loop, so its own
> // PeekMessage is exactly what should drive us.
> //*****************************************************************************
> BOOL W32JournalPlaybackOwnedByCurrentTask(VOID)
> {
>     return (W32JournalPlaybackActive() &&
>             (WORD)vaHookStateData[gW10JournalHookIdx].TaskId ==
>                 (WORD)CURRENTPTD()->htask16);
> }
> 
> //*****************************************************************************
> // W32InjectJournalEvent - deliver one played-back event to the input stream.
> //
> // Real WH_JOURNALPLAYBACK fed win32k's raw-input engine, reaching windows,
> // controls, menus, dialogs and modal loops with correct keyboard state.
> // keybd_event/mouse_event inject into that same raw input queue (SendInput
> // would too but is absent from this build's import libs), but they are
> // system-wide, so injection is gated hard:
> //
> //   (1) OUR process must own the foreground window -- never leak synthetic
> //       input into another host application if NTVDM has lost focus; and
> //   (2) that foreground window must belong to a DIFFERENT thread than this
> //       pump -- i.e. a different WOW task: one 16-bit app scripting another
> //       (APPTUTOR driving Approach into opening a dialog). A task that plays
> //       events to ITSELF (MSARN200's Alt+Space,X self-maximize) is
> //       deliberately NOT injected: Alt+Space would open a host modal
> //       system-menu loop in that same thread, the app would stop calling our
> //       PeekMessage, the pump could no longer fetch the remaining events, and
> //       playback would deadlock. Those apps only need the sequence to
> //       COMPLETE, which the caller still provides by running HC_GETNEXT/HC_SKIP
> //       to exhaustion. WOW runs each task on its own host thread, so a
> //       foreground thread != this thread reliably means a different task.
> //
> // EVENTMSG keyboard packing: LOBYTE(paramL)=virtual key, HIBYTE(paramL)=scan
> // code (see ThunkJournalHook's FE_SB path); mouse packing: paramL=x, paramH=y
> // in screen coordinates.
> //*****************************************************************************
> VOID W32InjectJournalEvent(LPEVENTMSG lpEvt)
> {
>     HWND  hwndFg;
>     DWORD pidFg = 0;
>     DWORD tidFg;
> 
>     hwndFg = GetForegroundWindow();
>     if (!hwndFg) {
>         return;
>     }
>     tidFg = GetWindowThreadProcessId(hwndFg, &pidFg);
>     if (pidFg != GetCurrentProcessId() || tidFg == GetCurrentThreadId()) {
>         return;                         // not us in front, or self-play
>     }
> 
>     //
>     // keybd_event / mouse_event (not SendInput -- absent from this build's
>     // import libs; wuman.c uses these same two) inject into the raw input
>     // queue and reach modal loops, which is what playback needs.
>     //
>     switch (lpEvt->message) {
> 
>     case WM_KEYDOWN:
>     case WM_KEYUP:
>     case WM_SYSKEYDOWN:
>     case WM_SYSKEYUP:
>         keybd_event(LOBYTE(lpEvt->paramL),                  // virtual key
>                     HIBYTE(lpEvt->paramL),                  // scan code
>                     ((lpEvt->message == WM_KEYUP ||
>                       lpEvt->message == WM_SYSKEYUP) ? KEYEVENTF_KEYUP : 0) |
>                     ((lpEvt->paramH & 0x8000) ? KEYEVENTF_EXTENDEDKEY : 0),
>                     0);
>         break;
> 
>     case WM_MOUSEMOVE:
>     case WM_LBUTTONDOWN:  case WM_LBUTTONUP:  case WM_LBUTTONDBLCLK:
>     case WM_RBUTTONDOWN:  case WM_RBUTTONUP:  case WM_RBUTTONDBLCLK:
>     case WM_MBUTTONDOWN:  case WM_MBUTTONUP:  case WM_MBUTTONDBLCLK:
