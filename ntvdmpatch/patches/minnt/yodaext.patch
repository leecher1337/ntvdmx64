>     /*
>     ** Non-interactive INT call log. Enable with: trace int_call
>     ** Logs both INT entry (0xCC/INT3, 0xCD/INT imm8) and the matching IRET
>     ** (0xCF) return state. The IRET line shows AX (API result), CF (success
>     ** flag for most DOS/DPMI/VBE calls) and other relevant flags.
>     **
>     ** A small depth counter is maintained so hardware IRQs (which enter
>     ** the CPU without a 0xCC/0xCD opcode but end with 0xCF) are not logged
>     ** as IRETs -- they would otherwise flood the trace at the timer/keyboard
>     ** tick rate. Counter increments on software INT entry, decrements on
>     ** IRET when > 0; IRETs while depth == 0 are silently skipped.
>     **
>     ** Lives in check_I so it works for any CPU backend (CCPU, HAXM).
>     */
>     if (sub_io_verbose & INT_CALL_VERBOSE) {
> 	static int int_call_depth = 0;
> 
> 	if (temp_opcode == 0xCC || temp_opcode == 0xCD) {
> 		char ts[200];
> 		IU8 int_num = (temp_opcode == 0xCC) ? 3 : sas_hw_at(addr+1);
> 		int_call_depth++;
> 		sprintf(ts,
> 		        "INT %02xh  AX=%04x BX=%04x CX=%04x DX=%04x "
