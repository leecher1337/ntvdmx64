> 		        (unsigned)getAX(), (unsigned)getBX(),
> 		        (unsigned)getCX(), (unsigned)getDX(),
> 		        (unsigned)getSI(), (unsigned)getDI(),
> 		        (unsigned)check_I_cs, (unsigned long)check_I_ip);
> 		trace(ts, 0);
> 	}
> 	else if (temp_opcode == 0xCF && int_call_depth > 0) {
