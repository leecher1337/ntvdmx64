> 		sprintf(ts,
> 		        "IRET     AX=%04x BX=%04x CX=%04x DX=%04x "
> 		        "SI=%04x DI=%04x CF=%d ZF=%d SF=%d",
> 		        (unsigned)getAX(), (unsigned)getBX(),
> 		        (unsigned)getCX(), (unsigned)getDX(),
