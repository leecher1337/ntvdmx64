3142a3169,3214
> #ifdef HAXM
>                 /* Polling-guest deadlock breaker :
>                  * a keyboard-IRQ EOI can stay stuck pending on HAXM (the
>                  * EOI/IretHook doesn't complete -- same class as the DOOM exit
>                  * hang).  The byte IS transferred to the output buffer
>                  * (output_full=1) but KbdIntDelay() bails on bKbdEoiPending before
>                  * raising OBF (kbd_status bit0), so port 0x64 reads back OBF=0.  A
>                  * guest that POLLS port 0x64 for that byte with IF=0 (e.g. WPS's
>                  * 0xED Set-LEDs -> wait 0xFA ACK) then spins forever.  After many
>                  * consecutive status reads with output_full=1 && OBF=0 (a spin
>                  * loop, not a transient IRQ window), surface OBF so the poll
>                  * succeeds, and flag it so the port-0x60 read frees the buffer
>                  * (else the next poll re-delivers this stale byte -> a phantom
>                  * 0xFA "keypress" into the menu). */
>                 {
>                     static int s_kbd_poll_stuck = 0;
>                     /* A byte the polling guest is waiting for may be stuck either
>                      * already in the output buffer (output_full, OBF blocked) or
>                      * still in the 6805 queue (feeder blocked by bKbdEoiPending). */
>                     int have_byte = output_full
>                                   || (free_6805_buff_size < BUFF_6805_VMAX);
>                     if (s_kbd_ack_expected
>                         && bKbdEoiPending && have_byte && !(kbd_status & 1)
>                         && !keyboard_interface_disabled) {
>                         if (++s_kbd_poll_stuck > 64) {
>                             s_kbd_poll_stuck = 0;
>                             /* Pull a queued byte into the output buffer if needed. */
>                             if (!output_full
>                                 && free_6805_buff_size < BUFF_6805_VMAX) {
>                                 char sc = translate_6805_8042();
>                                 if (!waiting_for_upcode) {
>                                     output_contents = sc;
>                                     output_full     = TRUE;
>                                 }
>                             }
>                             if (output_full) {
>                                 KbdData    = output_contents; /* port-0x60 read source */
>                                 kbd_status |= 1;              /* OBF: surface to poll */
>                                 s_kbd_polled_pending = TRUE;
>                             }
>                         }
>                     } else {
>                         s_kbd_poll_stuck = 0;
>                     }
>                 }
> #endif
